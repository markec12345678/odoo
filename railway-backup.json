{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.backup"
  },
  "deploy": {
    "startCommand": "/usr/local/bin/backup.sh",
    "cronSchedule": "0 3 * * *",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
