<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_si_timesheet_remind_unsubmitted" model="ir.cron">
            <field name="name">SI Timesheet: Remind unsubmitted</field>
            <field name="model_id" ref="model_l10n_si_timesheet_week"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_unsubmitted()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=9, minute=0, second=0) + relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
