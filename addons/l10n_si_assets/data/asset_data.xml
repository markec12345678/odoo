<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_l10n_si_asset" model="ir.sequence">
            <field name="name">SI Asset</field>
            <field name="code">l10n_si.asset</field>
            <field name="prefix">OS/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="cron_si_asset_monthly_dep" model="ir.cron">
            <field name="name">SI Assets: Monthly Depreciation</field>
            <field name="model_id" ref="model_l10n_si_asset"/>
            <field name="state">code</field>
            <field name="code">model.action_generate_monthly_depreciation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(day=1, hour=1, minute=0, second=0) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
        <record id="asset_cat_it_equipment" model="l10n_si.asset.category">
            <field name="name">IT oprema</field>
            <field name="code">IT</field>
            <field name="depreciation_method">linear</field>
            <field name="depreciation_rate">33.3</field>
            <field name="useful_life_years">3</field>
        </record>
        <record id="asset_cat_furniture" model="l10n_si.asset.category">
            <field name="name">Pohištvo</field>
            <field name="code">POH</field>
            <field name="depreciation_method">linear</field>
            <field name="depreciation_rate">20.0</field>
            <field name="useful_life_years">5</field>
        </record>
        <record id="asset_cat_buildings" model="l10n_si.asset.category">
            <field name="name">Stavbe</field>
            <field name="code">STV</field>
            <field name="depreciation_method">linear</field>
            <field name="depreciation_rate">2.5</field>
            <field name="useful_life_years">40</field>
        </record>
        <record id="asset_cat_vehicles" model="l10n_si.asset.category">
            <field name="name">Vozila</field>
            <field name="code">VOZ</field>
            <field name="depreciation_method">linear</field>
            <field name="depreciation_rate">20.0</field>
            <field name="useful_life_years">5</field>
        </record>
    </data>
</odoo>
