<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_channel_config_tree" model="ir.ui.view">
        <field name="name">l10n_si.channel.config.tree</field>
        <field name="model">l10n_si.channel.config</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'"
                  decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="channel"/>
                <field name="hotel_id_on_channel"/>
                <field name="sync_frequency_minutes"/>
                <field name="last_sync"/>
                <field name="last_sync_status"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_channel_config_form" model="ir.ui.view">
        <field name="name">l10n_si.channel.config.form</field>
        <field name="model">l10n_si.channel.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test povezave" class="btn-secondary"/>
                    <button name="action_sync_now" type="object" string="Sinhoniziraj zdaj" class="btn-primary"
                            invisible="[('state', '!=', 'active')]"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="channel"/>
                            <field name="hotel_id_on_channel"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="sync_frequency_minutes"/>
                            <field name="auto_pull_reservations"/>
                            <field name="auto_push_availability"/>
                            <field name="auto_push_rates"/>
                            <field name="markup_percent"/>
                        </group>
                    </group>
                    <group string="API poverilnice">
                        <group>
                            <field name="api_endpoint"/>
                            <field name="api_username"/>
                            <field name="api_password" password="True"/>
                        </group>
                        <group>
                            <field name="api_key" password="True"/>
                        </group>
                    </group>
                    <group string="Status">
                        <group>
                            <field name="last_sync" readonly="1"/>
                            <field name="last_sync_status" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_error" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mapiranje sob">
                            <field name="room_mapping_ids">
                                <list editable="bottom">
                                    <field name="si_model"/>
                                    <field name="room_type_id" invisible="[('si_model', '!=', 'hotel')]" required="[('si_model', '=', 'hotel')]"/>
                                    <field name="parcel_id" invisible="[('si_model', '!=', 'camping')]" required="[('si_model', '=', 'camping')]"/>
                                    <field name="channel_room_type_id"/>
                                    <field name="channel_room_type_name"/>
                                    <field name="price_override"/>
                                    <field name="min_stay_nights"/>
                                    <field name="max_stay_nights"/>
                                </list>
                            </field>
                        </page>
                        <page string="Logi">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="log_type"/>
                                    <field name="state"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_channel_config" model="ir.actions.act_window">
        <field name="name">Channel Manager</field>
        <field name="res_model">l10n_si.channel.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_si_channel_root" name="Channel Manager" parent="l10n_si_hotel.menu_l10n_si_hotel_root" sequence="80"/>
    <menuitem id="menu_l10n_si_channel_config" name="Kanali" parent="menu_l10n_si_channel_root" action="action_l10n_si_channel_config"/>
</odoo>
