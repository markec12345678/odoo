<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_channel_log_tree" model="ir.ui.view">
        <field name="name">l10n_si.channel.log.tree</field>
        <field name="model">l10n_si.channel.log</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'success'"
                  decoration-danger="state == 'error'">
                <field name="create_date"/>
                <field name="channel_config_id"/>
                <field name="log_type"/>
                <field name="state"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_channel_log_form" model="ir.ui.view">
        <field name="name">l10n_si.channel.log.form</field>
        <field name="model">l10n_si.channel.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="channel_config_id"/>
                        <field name="log_type"/>
                        <field name="state"/>
                        <field name="create_date" readonly="1"/>
                    </group>
                    <group string="Sporočilo">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="Raw payload">
                        <field name="raw_payload" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_channel_log" model="ir.actions.act_window">
        <field name="name">Logi sinhronizacije</field>
        <field name="res_model">l10n_si.channel.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_si_channel_log" name="Logi" parent="menu_l10n_si_channel_root" action="action_l10n_si_channel_log"/>
</odoo>
