<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Yearly sequence refresh: ensures a new ir.sequence is created
             for each device on Jan 1st at 00:05. The new sequence is created
             lazily on first invoice of the year via _get_or_create_yearly_sequence. -->
        <record id="cron_si_sequence_yearly_refresh" model="ir.cron">
            <field name="name">SI: Refresh Yearly Sequences</field>
            <field name="model_id" ref="model_l10n_si_electronic_device"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_yearly_sequences()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(month=1, day=1, hour=0, minute=5) + relativedelta(years=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
