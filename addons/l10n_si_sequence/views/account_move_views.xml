<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_si_sequence" model="ir.ui.view">
        <field name="name">account.move.form.si.sequence</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_si_business_premise_id"
                       attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
                <field name="l10n_si_electronic_device_id"
                       attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
                <field name="l10n_si_sequence_number" readonly="1"
                       attrs="{'invisible': [('l10n_si_sequence_number', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
