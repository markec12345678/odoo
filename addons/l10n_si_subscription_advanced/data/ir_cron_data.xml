<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_l10n_si_subscription" model="ir.sequence">
            <field name="name">SI Subscription</field>
            <field name="code">l10n_si.subscription</field>
            <field name="prefix">SUB/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="cron_si_subscription_generate_invoices" model="ir.cron">
            <field name="name">SI Subscription: Generate Invoices</field>
            <field name="model_id" ref="model_l10n_si_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=1, minute=0, second=0) + relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
