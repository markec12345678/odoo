<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_l10n_si_hotel_folio" model="ir.sequence">
            <field name="name">SI Hotel Folio</field>
            <field name="code">l10n_si.hotel.folio</field>
            <field name="prefix">FOL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_l10n_si_hotel_reservation" model="ir.sequence">
            <field name="name">SI Hotel Reservation</field>
            <field name="code">l10n_si.hotel.reservation</field>
            <field name="prefix">RES/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
