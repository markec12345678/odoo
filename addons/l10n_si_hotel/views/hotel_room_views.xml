<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_hotel_room_tree" model="ir.ui.view">
        <field name="name">l10n_si.hotel.room.tree</field>
        <field name="model">l10n_si.hotel.room</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'available'"
                  decoration-danger="state == 'occupied'"
                  decoration-info="state == 'reserved'"
                  decoration-warning="state == 'cleaning'"
                  decoration-muted="state == 'out_of_order'">
                <field name="number"/>
                <field name="floor"/>
                <field name="room_type_id"/>
                <field name="state"/>
                <field name="current_guest_name"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_hotel_room_kanban" model="ir.ui.view">
        <field name="name">l10n_si.hotel.room.kanban</field>
        <field name="model">l10n_si.hotel.room</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <field name="number"/>
                <field name="room_type_id"/>
                <field name="current_guest_name"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <div class="o_kanban_record_title">
                                <strong><field name="number"/></strong>
                            </div>
                            <div><field name="room_type_id"/></div>
                            <div t-if="record.current_guest_name.raw_value">
                                <small><field name="current_guest_name"/></small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_l10n_si_hotel_room_form" model="ir.ui.view">
        <field name="name">l10n_si.hotel.room.form</field>
        <field name="model">l10n_si.hotel.room</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_available" type="object" string="Prosta"
                            invisible="[('state', '=', 'available')]"/>
                    <button name="action_set_cleaning" type="object" string="Čiščenje"
                            invisible="[('state', '=', 'cleaning')]"/>
                    <button name="action_set_out_of_order" type="object" string="Vzdrževanje"
                            invisible="[('state', '=', 'out_of_order')]"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="floor"/>
                            <field name="room_type_id"/>
                        </group>
                        <group>
                            <field name="current_folio_id" readonly="1"/>
                            <field name="current_guest_name" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rezervacije">
                            <field name="reservation_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="check_in"/>
                                    <field name="check_out"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_hotel_room" model="ir.actions.act_window">
        <field name="name">Sobe</field>
        <field name="res_model">l10n_si.hotel.room</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
