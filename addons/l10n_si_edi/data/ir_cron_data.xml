<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Poll FURS for acceptance status of submitted XMLs. FURS returns
             acceptance asynchronously (usually within minutes). -->
        <record id="cron_si_edi_poll_status" model="ir.cron">
            <field name="name">SI e-Račun: Poll Acceptance Status</field>
            <field name="model_id" ref="model_l10n_si_edi_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_acceptance_status()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
