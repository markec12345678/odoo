<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_si_edi" model="ir.ui.view">
        <field name="name">account.move.form.si.edi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_si_edi_submit" type="object"
                        string="Submit e-Račun"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="['|', ('move_type', 'not in', ('out_invoice', 'out_refund')), ('l10n_si_edi_state', 'in', ('sent', 'accepted'))]"/>
                <button name="action_si_edi_download_xml" type="object"
                        string="Download XML"
                        class="oe_stat_button" icon="fa-download"
                        invisible="[('l10n_si_edi_state', '=', False)]"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="e-Račun (eSLOG 2.0)"
                       invisible="[('move_type', 'not in', ('out_invoice', 'out_refund'))]">
                    <field name="l10n_si_edi_state" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
