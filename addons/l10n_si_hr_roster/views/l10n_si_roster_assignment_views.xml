<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_roster_assignment_tree" model="ir.ui.view">
        <field name="name">l10n_si.roster.assignment.tree</field>
        <field name="model">l10n_si.roster.assignment</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'confirmed'"
                  decoration-success="state == 'completed'"
                  decoration-danger="state == 'no_show'"
                  decoration-muted="state == 'cancelled'">
                <field name="number"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="shift_id"/>
                <field name="scheduled_hours" widget="float_time"/>
                <field name="actual_hours" widget="float_time"/>
                <field name="overtime_hours" widget="float_time"/>
                <field name="is_overtime"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_roster_assignment_form" model="ir.ui.view">
        <field name="name">l10n_si.roster.assignment.form</field>
        <field name="model">l10n_si.roster.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Potrdi" class="btn-primary"
                            invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_start" type="object" string="Začni"
                            invisible="[('state', '!=', 'confirmed')]"/>
                    <button name="action_complete" type="object" string="Opravi" class="btn-primary"
                            invisible="[('state', '!=', 'in_progress')]"/>
                    <button name="action_no_show" type="object" string="Ni prišel"
                            invisible="[('state', '!=', 'confirmed')]"/>
                    <button name="action_cancel" type="object" string="Prekliči"
                            invisible="[('state', 'in', ('completed', 'cancelled'))]"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="number" readonly="1"/>
                            <field name="employee_id"/>
                            <field name="shift_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="scheduled_start" readonly="1"/>
                            <field name="scheduled_end" readonly="1"/>
                            <field name="scheduled_hours" widget="float_time" readonly="1"/>
                            <field name="break_minutes"/>
                        </group>
                    </group>
                    <group string="Dejanski čas">
                        <group>
                            <field name="actual_start" readonly="1"/>
                            <field name="actual_end" readonly="1"/>
                            <field name="actual_hours" widget="float_time" readonly="1"/>
                        </group>
                        <group>
                            <field name="is_overtime"/>
                            <field name="overtime_hours" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                    <group string="Povezave">
                        <field name="swap_request_id"/>
                        <field name="attendance_id"/>
                    </group>
                    <group string="Opombe">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_l10n_si_roster_assignment_calendar" model="ir.ui.view">
        <field name="name">l10n_si.roster.assignment.calendar</field>
        <field name="model">l10n_si.roster.assignment</field>
        <field name="arch" type="xml">
            <calendar string="Razpored" date_start="scheduled_start" date_stop="scheduled_end"
                      color="employee_id" event_open_popup="true">
                <field name="employee_id"/>
                <field name="shift_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_l10n_si_roster_assignment_search" model="ir.ui.view">
        <field name="name">l10n_si.roster.assignment.search</field>
        <field name="model">l10n_si.roster.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="number"/>
                <field name="employee_id"/>
                <field name="shift_id"/>
                <filter name="filter_today" string="Danes" domain="[('date', '=', context_today())]"/>
                <filter name="filter_this_week" string="Ta teden"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', (context_today() + relativedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_overtime" string="Nadure" domain="['|', ('is_overtime', '=', True), ('overtime_hours', '&gt;', 0)]"/>
                <group string="Group By">
                    <filter name="group_employee" string="Zaposleni" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_shift" string="Izmena" context="{'group_by': 'shift_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Datum" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_si_roster_assignment" model="ir.actions.act_window">
        <field name="name">Razpored</field>
        <field name="res_model">l10n_si.roster.assignment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_si_roster_root" name="Razpored" parent="hr.menu_hr_root" sequence="40"/>
    <menuitem id="menu_l10n_si_roster_assignment" name="Razpored delavnikov" parent="menu_l10n_si_roster_root" action="action_l10n_si_roster_assignment"/>
    <menuitem id="menu_l10n_si_roster_shift" name="Izmene" parent="menu_l10n_si_roster_root" action="action_l10n_si_roster_shift" sequence="90"/>
</odoo>
