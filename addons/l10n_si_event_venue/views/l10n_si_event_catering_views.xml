<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_event_catering_tree" model="ir.ui.view">
        <field name="name">l10n_si.event.catering.line.tree</field>
        <field name="model">l10n_si.event.catering.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="event_id"/>
                <field name="menu_item_id"/>
                <field name="quantity_type"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="subtotal" sum="Skupaj"/>
            </tree>
        </field>
    </record>

    <record id="action_l10n_si_event_catering_line" model="ir.actions.act_window">
        <field name="name">Catering postavke</field>
        <field name="res_model">l10n_si.event.catering.line</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
