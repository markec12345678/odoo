<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_event_package_tree" model="ir.ui.view">
        <field name="name">l10n_si.event.package.tree</field>
        <field name="model">l10n_si.event.package</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="min_guests"/>
                <field name="max_guests"/>
                <field name="base_price"/>
                <field name="duration_hours"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_event_package_form" model="ir.ui.view">
        <field name="name">l10n_si.event.package.form</field>
        <field name="model">l10n_si.event.package</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="base_price"/>
                            <field name="price_per_extra_guest"/>
                            <field name="duration_hours"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group string="Kapaciteta">
                        <group>
                            <field name="min_guests"/>
                            <field name="max_guests"/>
                        </group>
                    </group>
                    <group string="Vključuje">
                        <group>
                            <field name="includes_hall"/>
                            <field name="includes_catering"/>
                            <field name="includes_equipment"/>
                            <field name="includes_service_staff"/>
                        </group>
                        <group>
                            <field name="includes_decorations"/>
                            <field name="includes_photographer"/>
                            <field name="includes_music"/>
                            <field name="includes_valet"/>
                        </group>
                    </group>
                    <group string="Pogoji">
                        <group>
                            <field name="deposit_percent"/>
                            <field name="cancellation_days"/>
                            <field name="free_changes_days"/>
                        </group>
                    </group>
                    <group string="Opis">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_event_package" model="ir.actions.act_window">
        <field name="name">Paketi</field>
        <field name="res_model">l10n_si.event.package</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu item za catering items -->
    <record id="view_l10n_si_event_menu_item_tree" model="ir.ui.view">
        <field name="name">l10n_si.event.menu.item.tree</field>
        <field name="model">l10n_si.event.menu.item</field>
        <field name="arch" type="xml">
            <list decoration-success="vegetarian == True">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="price_per_person"/>
                <field name="vegetarian"/>
                <field name="vegan"/>
                <field name="gluten_free"/>
                <field name="contains_pork"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_event_menu_item_form" model="ir.ui.view">
        <field name="name">l10n_si.event.menu.item.form</field>
        <field name="model">l10n_si.event.menu.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="product_id"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="price_per_person"/>
                            <field name="price_per_unit"/>
                        </group>
                    </group>
                    <group string="Dieta">
                        <group>
                            <field name="vegetarian"/>
                            <field name="vegan"/>
                            <field name="gluten_free"/>
                        </group>
                        <group>
                            <field name="contains_pork"/>
                            <field name="contains_allergens"/>
                        </group>
                    </group>
                    <group string="Ustreza za">
                        <group>
                            <field name="suitable_for_wedding"/>
                            <field name="suitable_for_conference"/>
                            <field name="suitable_for_gala"/>
                        </group>
                    </group>
                    <group string="Opis">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_event_menu_item" model="ir.actions.act_window">
        <field name="name">Catering jedi</field>
        <field name="res_model">l10n_si.event.menu.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
