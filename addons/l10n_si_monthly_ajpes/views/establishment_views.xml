<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add smart button to establishment form -->
    <record id="view_etourism_establishment_form_monthly" model="ir.ui.view">
        <field name="name">l10n_si.etourism.establishment.form.monthly</field>
        <field name="model">l10n_si.etourism.establishment</field>
        <field name="inherit_id" ref="l10n_si_etourism.view_l10n_si_etourism_establishment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" type="object"
                            name="action_view_monthly_reports" icon="fa-file-text-o">
                        <field name="monthly_report_count" widget="statinfo" string="Monthly Reports"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
