<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron: 1st of each month at 02:00 — generate previous month's report -->
    <record id="cron_generate_monthly_ajpes_reports" model="ir.cron">
        <field name="name">AJPES: Generate Monthly Reports</field>
        <field name="model_id" ref="model_l10n_si_monthly_ajpes_report"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_monthly_reports()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
