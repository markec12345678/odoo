<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- XML report (downloadable from the form via xml_file Binary field) -->
    <!-- This is a QWeb template used only for the email attachment PDF -->
    <record id="report_monthly_ajpes_pdf" model="ir.actions.report">
        <field name="name">Monthly AJPES Report (PDF)</field>
        <field name="model">l10n_si.monthly.ajpes.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_si_monthly_ajpes.report_monthly_ajpes_pdf_template</field>
        <field name="report_file">l10n_si_monthly_ajpes.report_monthly_ajpes_pdf</field>
        <field name="print_report_name">'AJPES_%s_%d_%02d_v%d' % (object.establishment_id.name or 'est', object.year, object.month, object.version)</field>
    </record>

    <template id="report_monthly_ajpes_pdf_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h1>Monthly AJPES eTurizem Report</h1>
                    <div class="row mt-4">
                        <div class="col-6">
                            <strong>Establishment:</strong> <span t-field="doc.establishment_id.name"/><br/>
                            <strong>MID:</strong> <span t-field="doc.establishment_id.mid"/><br/>
                            <strong>Period:</strong> <span t-field="doc.month_name"/> <span t-field="doc.year"/><br/>
                            <strong>Version:</strong> <span t-field="doc.version"/><br/>
                            <strong>State:</strong> <span t-field="doc.state"/>
                        </div>
                        <div class="col-6">
                            <strong>Generated by:</strong> <span t-field="doc.generated_by.name"/><br/>
                            <strong>Generated on:</strong> <span t-field="doc.generated_on"/><br/>
                            <strong>Submitted on:</strong> <span t-field="doc.submitted_on"/><br/>
                            <strong>AJPES ID:</strong> <span t-field="doc.ajpes_submission_id"/>
                        </div>
                    </div>

                    <h2 class="mt-5" style="color: #875A7B;">Summary Statistics</h2>
                    <table class="table table-bordered">
                        <tr>
                            <td class="font-weight-bold">Total arrivals</td>
                            <td t-field="doc.total_arrivals"/>
                            <td class="font-weight-bold">Total departures</td>
                            <td t-field="doc.total_departures"/>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">Total nights</td>
                            <td t-field="doc.total_nights"/>
                            <td class="font-weight-bold">Avg stay (nights)</td>
                            <td t-field="doc.avg_stay_nights"/>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">Domestic (SI)</td>
                            <td t-field="doc.total_domestic"/>
                            <td class="font-weight-bold">Foreign</td>
                            <td t-field="doc.total_foreigners"/>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">Registration count</td>
                            <td colspan="3" t-field="doc.registration_count"/>
                        </tr>
                    </table>

                    <h2 class="mt-5" style="color: #875A7B;">Country Breakdown</h2>
                    <t t-set="countries" t-value="doc.get_country_breakdown()"/>
                    <t t-if="countries">
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Country</th><th class="text-right">Guests</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="countries" t-as="c">
                                    <td t-out="c[0]"/>
                                    <td class="text-right" t-out="c[1]"/>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <t t-else="">
                        <p class="text-muted">No country data available.</p>
                    </t>

                    <h2 class="mt-5" style="color: #875A7B;">Purpose Breakdown</h2>
                    <t t-set="purposes" t-value="doc.get_purpose_breakdown()"/>
                    <t t-if="purposes">
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Purpose</th><th class="text-right">Guests</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="purposes" t-as="p">
                                    <td t-out="p[0]"/>
                                    <td class="text-right" t-out="p[1]"/>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <t t-else="">
                        <p class="text-muted">No purpose data available.</p>
                    </t>

                    <p class="text-muted mt-5" style="font-size: 11px;">
                        This report was generated by the SI/HR Tourism Suite for submission to AJPES.
                        Retention period: 7 years (per Slovenian accounting law).
                    </p>
                </div>
            </t>
        </t>
    </template>
</odoo>
