<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_request_form_si" model="ir.ui.view">
        <field name="name">maintenance.request.form.si</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="SI Maintenance Data">
                    <group>
                        <field name="si_cost"/>
                        <field name="si_downtime_hours" widget="float_time"/>
                        <field name="si_schedule_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="si_root_cause"/>
                        <field name="si_action_taken"/>
                    </group>
                </group>
                <notebook>
                    <page string="Potrošni material">
                        <field name="si_parts_line_ids">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="unit_price"/>
                                <field name="subtotal"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
