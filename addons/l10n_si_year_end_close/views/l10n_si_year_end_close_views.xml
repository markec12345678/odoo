<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_yec_tree" model="ir.ui.view">
        <field name="name">l10n_si.year.end.close.tree</field>
        <field name="model">l10n_si.year.end.close</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="year"/><field name="net_profit"/><field name="state"/></list></field>
    </record>
    <record id="view_l10n_si_yec_form" model="ir.ui.view">
        <field name="name">l10n_si.year.end.close.form</field>
        <field name="model">l10n_si.year.end.close</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Izračunaj" class="btn-secondary" attrs="{'invisible': [('state','!=','draft')]}"/>
                    <button name="action_post" type="object" string="Knjiži" class="btn-primary" attrs="{'invisible': [('state','!=','computed')]}"/>
                    <button name="action_close" type="object" string="Zaključi" attrs="{'invisible': [('state','!=','posted')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="number" readonly="1"/><field name="year"/><field name="profit_loss_account_id"/><field name="closing_account_id"/></group>
                        <group><field name="net_profit" widget="monetary" readonly="1"/><field name="move_id" readonly="1"/><field name="computed_on" readonly="1"/><field name="posted_on" readonly="1"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_l10n_si_yec" model="ir.actions.act_window">
        <field name="name">Zaključitev leta</field>
        <field name="res_model">l10n_si.year.end.close</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_l10n_si_yec" name="Zaključitev leta" parent="account.menu_finance_configuration" sequence="140" action="action_l10n_si_yec"/>
</odoo>
