<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_l10n_si_etourism" model="ir.module.category">
            <field name="name">SI eTurizem (AJPES)</field>
            <field name="sequence">20</field>
        </record>
        <record id="group_etourism_user" model="res.groups">
            <field name="name">SI eTurizem / User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_etourism_manager" model="res.groups">
            <field name="name">SI eTurizem / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_etourism_user'))]"/>
        </record>
        <record id="rule_etourism_company" model="ir.rule">
            <field name="name">SI eTurizem: multi-company</field>
            <field name="model_id" ref="model_l10n_si_etourism_establishment"/>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
