<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="housekeeping_team_company_rule" model="ir.rule">
        <field name="name">Housekeeping Team: multi-company</field>
        <field name="model_id" ref="model_l10n_si_housekeeping_team"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>
    <record id="housekeeping_config_company_rule" model="ir.rule">
        <field name="name">Housekeeping Config: multi-company</field>
        <field name="model_id" ref="model_l10n_si_housekeeping_config"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>
</odoo>
