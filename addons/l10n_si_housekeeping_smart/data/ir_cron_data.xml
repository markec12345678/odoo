<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily: balance unassigned tasks at 07:30 -->
    <record id="cron_balance_housekeeping_workload" model="ir.cron">
        <field name="name">Housekeeping: Balance Workload</field>
        <field name="model_id" ref="model_l10n_si_housekeeping_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_balance_workload()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
    <!-- Hourly: update urgency based on next check-in -->
    <record id="cron_update_urgency" model="ir.cron">
        <field name="name">Housekeeping: Update Urgency</field>
        <field name="model_id" ref="model_l10n_si_housekeeping_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_urgency()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
