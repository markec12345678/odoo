<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generate_tasks_wizard_form" model="ir.ui.view">
        <field name="name">l10n_si.housekeeping.generate.tasks.wizard.form</field>
        <field name="model">l10n_si.housekeeping.generate.tasks.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Housekeeping Tasks">
                <group>
                    <field name="date"/>
                    <field name="auto_assign"/>
                    <field name="created_count" readonly="1" invisible="created_count == 0"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_tasks_wizard" model="ir.actions.act_window">
        <field name="name">Generate Tasks</field>
        <field name="res_model">l10n_si.housekeeping.generate.tasks.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
