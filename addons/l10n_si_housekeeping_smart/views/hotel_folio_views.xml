<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add housekeeping smart button to folio -->
    <record id="view_hotel_folio_form_housekeeping" model="ir.ui.view">
        <field name="name">l10n_si.hotel.folio.form.housekeeping</field>
        <field name="model">l10n_si.hotel.folio</field>
        <field name="inherit_id" ref="l10n_si_hotel.view_hotel_folio_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_housekeeping_tasks" icon="fa-broom">
                    <span class="o_stat_text">Turnover</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
