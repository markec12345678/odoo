<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_sign_upload_wizard_form" model="ir.ui.view">
        <field name="name">l10n_si.sign.upload.wizard.form</field>
        <field name="model">l10n_si.sign.upload.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="document" filename="document_filename"/>
                    <field name="document_filename" invisible="1"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_sign" type="object"
                            string="Podpiši" class="btn-primary"/>
                    <button special="cancel" string="Prekliči" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_sign_upload_wizard" model="ir.actions.act_window">
        <field name="name">Quick Sign</field>
        <field name="res_model">l10n_si.sign.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_si_sign_quick"
              name="Quick Sign"
              parent="menu_si_sign_root"
              action="action_l10n_si_sign_upload_wizard"
              sequence="5"/>
</odoo>
