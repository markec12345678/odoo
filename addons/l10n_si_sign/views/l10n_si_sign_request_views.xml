<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_sign_request_tree" model="ir.ui.view">
        <field name="name">l10n_si.sign.request.tree</field>
        <field name="model">l10n_si.sign.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'pending'"
                  decoration-success="state == 'signed'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="document_attachment_id"/>
                <field name="state"/>
                <field name="signed_on"/>
                <field name="signed_by"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_sign_request_form" model="ir.ui.view">
        <field name="name">l10n_si.sign.request.form</field>
        <field name="model">l10n_si.sign.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Pošlji v podpis"
                            class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_sign_all" type="object" string="Podpiši vse"
                            class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <button name="action_reject" type="object" string="Zavrni"
                            attrs="{'invisible': [('state', 'in', ('signed', 'rejected', 'archived'))]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_download_signed" type="object"
                                class="oe_stat_button" icon="fa-download"
                                attrs="{'invisible': [('document_signed_attachment_id', '=', False)]}">
                            <span class="o_stat_text">Download</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="reference"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="workflow_type"/>
                            <field name="signed_on" readonly="1"/>
                            <field name="signed_by" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dokument">
                            <field name="document_attachment_id" widget="url"/>
                            <field name="document_signed_attachment_id" widget="url" readonly="1"/>
                        </page>
                        <page string="Podpisniki">
                            <field name="signature_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="signer_user_id"/>
                                    <field name="role"/>
                                    <field name="state"/>
                                    <field name="signed_on" readonly="1"/>
                                    <button name="action_sign" type="object" string="Podpiši"
                                            class="btn-sm btn-primary"
                                            attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Opombe">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_sign_request" model="ir.actions.act_window">
        <field name="name">SI Sign Requests</field>
        <field name="res_model">l10n_si.sign.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_si_sign_root"
              name="SI Sign"
              parent="base.menu_administration"
              sequence="90"/>

    <menuitem id="menu_si_sign_request"
              name="Sign Requests"
              parent="menu_si_sign_root"
              action="action_l10n_si_sign_request"/>
</odoo>
