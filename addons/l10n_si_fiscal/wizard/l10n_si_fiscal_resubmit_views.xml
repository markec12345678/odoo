<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_fiscal_resubmit_wizard" model="ir.ui.view">
        <field name="name">l10n_si.fiscal.resubmit.wizard.form</field>
        <field name="model">l10n_si.fiscal.resubmit.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="move_ids"/>
                <footer>
                    <button name="action_resubmit" type="object"
                            string="Resubmit" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
