<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_si_fiscal" model="ir.ui.view">
        <field name="name">res.company.form.si.fiscal</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Slovenian Fiscal Verification (FURS)"
                       name="si_fiscal_group"
                       attrs="{'invisible': [('country_id', '!=', %(base.si)s)]}">
                    <group>
                        <field name="si_fiscal_enabled"/>
                        <field name="si_fiscal_environment"
                               attrs="{'invisible': [('si_fiscal_enabled', '=', False)]}"/>
                        <field name="si_fiscal_auto_submit"
                               attrs="{'invisible': [('si_fiscal_enabled', '=', False)]}"/>
                        <field name="si_fiscal_software_supplier_tax_no"
                               attrs="{'invisible': [('si_fiscal_enabled', '=', False)]}"/>
                    </group>
                    <group>
                        <field name="si_fiscal_certificate" filename="si_fiscal_certificate_filename"
                               attrs="{'invisible': [('si_fiscal_enabled', '=', False)]}"/>
                        <field name="si_fiscal_certificate_filename" invisible="1"/>
                        <field name="si_fiscal_certificate_password" password="True"
                               attrs="{'invisible': [('si_fiscal_enabled', '=', False)]}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
