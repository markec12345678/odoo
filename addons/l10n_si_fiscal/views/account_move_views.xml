<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_si_fiscal" model="ir.ui.view">
        <field name="name">account.move.form.si.fiscal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_si_sequence_number']" position="after">
                <group string="Fiscal Verification (FURS)"
                       invisible="[('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]">
                    <field name="l10n_si_zoi" readonly="1"/>
                    <field name="l10n_si_eor" readonly="1"/>
                    <field name="l10n_si_fiscal_state" readonly="1"/>
                    <field name="l10n_si_fiscal_submitted_at" readonly="1"/>
                    <field name="l10n_si_fiscal_qr" widget="image" readonly="1"
                           invisible="[('l10n_si_fiscal_qr', '=', False)]"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Add "Re-submit to FURS" action in the action menu -->
    <record id="action_move_si_resubmit" model="ir.actions.server">
        <field name="name">Re-submit to FURS</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_si_resubmit_to_furs()
        </field>
    </record>
</odoo>
