<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_group_booking_tree" model="ir.ui.view">
        <field name="name">l10n_si.group.booking.tree</field>
        <field name="model">l10n_si.group.booking</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'confirmed'"
                  decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="number"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="group_type"/>
                <field name="date_from"/>
                <field name="nights"/>
                <field name="room_count_booked"/>
                <field name="total_amount" sum="Skupaj"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_l10n_si_group_booking_form" model="ir.ui.view">
        <field name="name">l10n_si.group.booking.form</field>
        <field name="model">l10n_si.group.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_quote" type="object" string="Pošlji ponudbo"
                            attrs="{'invisible': [('state', '!=', 'inquiry')]}"/>
                    <button name="action_confirm" type="object" string="Potrdi" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'quoted')]}"/>
                    <button name="action_register_deposit" type="object" string="Zabeleži avans"
                            attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_set_in_house" type="object" string="V hotelu" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'deposit_paid')]}"/>
                    <button name="action_complete" type="object" string="Zaključi"
                            attrs="{'invisible': [('state', '!=', 'in_house')]}"/>
                    <button name="action_cancel" type="object" string="Prekliči"
                            attrs="{'invisible': [('state', 'in', ('completed', 'cancelled'))]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="number" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="group_name"/>
                            <field name="group_type"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="nights" readonly="1"/>
                            <field name="meal_plan"/>
                            <field name="meal_plan_price_per_person"/>
                        </group>
                    </group>
                    <group string="Sobe">
                        <group>
                            <field name="room_type_id"/>
                            <field name="room_count_booked"/>
                            <field name="room_count_confirmed" readonly="1"/>
                            <field name="room_count_available" readonly="1"/>
                        </group>
                        <group>
                            <field name="group_rate_per_night"/>
                            <field name="commission_percent"/>
                            <field name="free_leader_every_n"/>
                        </group>
                    </group>
                    <group string="Datumi cut-off">
                        <group>
                            <field name="cutoff_date"/>
                            <field name="allocation_release_date"/>
                        </group>
                    </group>
                    <group string="Cene">
                        <group>
                            <field name="total_amount" widget="monetary" readonly="1"/>
                            <field name="commission_amount" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rooming list">
                            <field name="rooming_list_ids">
                                <tree editable="bottom">
                                    <field name="room_number"/>
                                    <field name="guest_name"/>
                                    <field name="adults"/>
                                    <field name="children"/>
                                    <field name="is_leader"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Posebne zahteve">
                            <field name="special_requirements" nolabel="1"/>
                        </page>
                        <page string="Interne opombe">
                            <field name="internal_notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_group_booking" model="ir.actions.act_window">
        <field name="name">Skupinske rezervacije</field>
        <field name="res_model">l10n_si.group.booking</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_l10n_si_group_booking_root" name="Skupinske rezervacije" parent="l10n_si_hotel.menu_l10n_si_hotel_root" sequence="60"/>
    <menuitem id="menu_l10n_si_group_booking" name="Skupine" parent="menu_l10n_si_group_booking_root" action="action_l10n_si_group_booking"/>
</odoo>
