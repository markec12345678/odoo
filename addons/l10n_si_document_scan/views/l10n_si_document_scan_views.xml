<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Document Scan list view -->
    <record id="view_l10n_si_document_scan_list" model="ir.ui.view">
        <field name="name">l10n_si.document.scan.list</field>
        <field name="model">l10n_si.document.scan</field>
        <field name="arch" type="xml">
            <list decoration-success="ocr_status == 'done'"
                  decoration-danger="ocr_status == 'failed'"
                  decoration-warning="ocr_status == 'processing'">
                <field name="scan_number"/>
                <field name="document_type"/>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="document_number"/>
                <field name="nationality_country_id"/>
                <field name="ocr_status"/>
                <field name="document_expired" invisible="1"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Document Scan form view -->
    <record id="view_l10n_si_document_scan_form" model="ir.ui.view">
        <field name="name">l10n_si.document.scan.form</field>
        <field name="model">l10n_si.document.scan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_ocr" type="object"
                            string="🤖 Zaženi OCR" class="btn-primary"
                            invisible="[('ocr_status', 'in', ['done', 'processing'])]"/>
                    <button name="action_create_guest_registration" type="object"
                            string="📋 Ustvari eTurizem prijavo" class="btn-success"
                            invisible="[('ocr_status', '!=', 'done')]"/>
                    <field name="ocr_status" widget="statusbar"
                           statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="scan_number" readonly="1"/>
                            <field name="document_type"/>
                            <field name="document_image" widget="image"/>
                            <field name="document_image_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="guest_registration_id"/>
                            <field name="document_expired"
                                   decoration-danger="document_expired == True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="OCR podatki">
                            <group>
                                <group string="Osebni podatki">
                                    <field name="first_name"/>
                                    <field name="last_name"/>
                                    <field name="birth_date"/>
                                    <field name="sex"/>
                                    <field name="personal_number"/>
                                </group>
                                <group string="Dokument">
                                    <field name="document_number"/>
                                    <field name="nationality_country_id"/>
                                    <field name="document_country_id"/>
                                    <field name="document_expiry"/>
                                </group>
                            </group>
                            <group string="Validacija">
                                <field name="validation_warnings" nolabel="1"
                                       widget="text"/>
                            </group>
                        </page>
                        <page string="MRZ / Raw OCR" invisible="[('ocr_raw_text', '=', False)]">
                            <group string="MRZ (Machine Readable Zone)">
                                <field name="ocr_mrz" nolabel="1" widget="text"/>
                            </group>
                            <group string="Surovi OCR tekst">
                                <field name="ocr_raw_text" nolabel="1" widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_l10n_si_document_scan_search" model="ir.ui.view">
        <field name="name">l10n_si.document.scan.search</field>
        <field name="model">l10n_si.document.scan</field>
        <field name="arch" type="xml">
            <search>
                <field name="scan_number"/>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="document_number"/>
                <field name="partner_id"/>
                <filter name="filter_done" string="OCR zaključen"
                        domain="[('ocr_status', '=', 'done')]"/>
                <filter name="filter_failed" string="OCR neuspešen"
                        domain="[('ocr_status', '=', 'failed')]"/>
                <filter name="filter_expired" string="Potekli dokumenti"
                        domain="[('document_expired', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Vrsta dokumenta"
                            context="{'group_by': 'document_type'}"/>
                    <filter name="group_status" string="Status OCR"
                            context="{'group_by': 'ocr_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_l10n_si_document_scan" model="ir.actions.act_window">
        <field name="name">Document Scans</field>
        <field name="res_model">l10n_si.document.scan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_l10n_si_document_scan_root"
              name="📊 Document Scan"
              parent="l10n_si_etourism.menu_l10n_si_etourism_root"
              sequence="15"/>
    <menuitem id="menu_l10n_si_document_scan"
              name="Skenirani dokumenti"
              parent="menu_l10n_si_document_scan_root"
              action="action_l10n_si_document_scan"
              sequence="10"/>
</odoo>
