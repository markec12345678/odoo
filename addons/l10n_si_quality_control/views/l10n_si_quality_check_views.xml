<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_quality_check_tree" model="ir.ui.view">
        <field name="name">l10n_si.quality.check.tree</field>
        <field name="model">l10n_si.quality.check</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'pass'"
                  decoration-danger="state == 'fail'"
                  decoration-warning="state == 'partial'">
                <field name="number"/>
                <field name="name"/>
                <field name="check_type"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="inspector_id"/>
                <field name="inspection_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_l10n_si_quality_check_form" model="ir.ui.view">
        <field name="name">l10n_si.quality.check.form</field>
        <field name="model">l10n_si.quality.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_complete" type="object" string="Zaključi pregled" class="btn-primary"
                            attrs="{'invisible': [('state', 'in', ('pass', 'fail', 'partial'))]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="number"/>
                            <field name="check_type"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                        </group>
                        <group>
                            <field name="inspector_id"/>
                            <field name="inspection_date"/>
                            <field name="production_id"/>
                            <field name="picking_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Točke preverjanja">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="check_kind"/>
                                    <field name="min_value"/>
                                    <field name="max_value"/>
                                    <field name="target_value"/>
                                    <field name="measured_value"/>
                                    <field name="measured_text"/>
                                    <field name="result"/>
                                    <field name="critical"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Opombe">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_quality_check" model="ir.actions.act_window">
        <field name="name">Quality Checks (SI)</field>
        <field name="res_model">l10n_si.quality.check</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_si_quality_root" name="SI Quality" parent="mrp.menu_mrp_root" sequence="80"/>
    <menuitem id="menu_si_quality_check" name="Checks" parent="menu_si_quality_root" action="action_l10n_si_quality_check"/>
</odoo>
