<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_transport_tree" model="ir.ui.view">
        <field name="name">l10n_si.transport.booking.tree</field>
        <field name="model">l10n_si.transport.booking</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'completed'" decoration-info="state == 'confirmed'">
                <field name="number"/>
                <field name="pickup_datetime"/>
                <field name="partner_id"/>
                <field name="transport_type"/>
                <field name="pickup_location"/>
                <field name="dropoff_location"/>
                <field name="price" sum="Skupaj"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_l10n_si_transport_form" model="ir.ui.view">
        <field name="name">l10n_si.transport.booking.form</field>
        <field name="model">l10n_si.transport.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Potrdi" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_start" type="object" string="Začni" attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_complete" type="object" string="Opravi" class="btn-primary" attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                    <button name="action_cancel" type="object" string="Prekliči" attrs="{'invisible': [('state', 'in', ('completed', 'cancelled'))]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="number" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="hotel_folio_id"/>
                            <field name="transport_type"/>
                            <field name="flight_number" attrs="{'invisible': [('transport_type', '!=', 'airport_shuttle')]}"/>
                        </group>
                        <group>
                            <field name="pickup_datetime"/>
                            <field name="pickup_location"/>
                            <field name="dropoff_location"/>
                            <field name="passengers"/>
                            <field name="luggage_pieces"/>
                        </group>
                    </group>
                    <group string="Vozilo in voznik">
                        <group>
                            <field name="fleet_vehicle_id"/>
                            <field name="driver_id"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="charge_to_folio"/>
                        </group>
                    </group>
                    <group string="Opombe">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_l10n_si_transport" model="ir.actions.act_window">
        <field name="name">Transport</field>
        <field name="res_model">l10n_si.transport.booking</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_l10n_si_transport_root" name="Transport" parent="l10n_si_hotel.menu_l10n_si_hotel_root" sequence="65"/>
    <menuitem id="menu_l10n_si_transport" name="Rezervacije" parent="menu_l10n_si_transport_root" action="action_l10n_si_transport"/>
</odoo>
