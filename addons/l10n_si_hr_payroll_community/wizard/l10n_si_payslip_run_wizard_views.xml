<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_payslip_run_wizard_form" model="ir.ui.view">
        <field name="name">l10n_si.payslip.run.wizard.form</field>
        <field name="model">l10n_si.payslip.run.wizard</field>
        <field name="arch" type="xml">
            <form string="Mesečni obračun plač">
                <group>
                    <group>
                        <field name="year"/>
                        <field name="month"/>
                        <field name="structure_id"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <group string="Zaposleni (prazno = vsi aktivni)">
                    <field name="employee_ids" nolabel="1">
                        <tree>
                            <field name="name"/>
                            <field name="department_id"/>
                            <field name="job_title"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generiraj" class="btn-primary"/>
                    <button special="cancel" string="Prekliči" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_payslip_run_wizard" model="ir.actions.act_window">
        <field name="name">Mesečni obračun</field>
        <field name="res_model">l10n_si.payslip.run.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_si_payslip_run"
              name="Monthly Run"
              parent="menu_si_payroll_root"
              action="action_l10n_si_payslip_run_wizard"
              sequence="10"/>
</odoo>
