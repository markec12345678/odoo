<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Auto M4 generation on the 1st of each month for the previous period -->
        <record id="cron_si_payroll_auto_m4" model="ir.cron">
            <field name="name">SI Payroll: Auto-generate M4</field>
            <field name="model_id" ref="model_l10n_si_payslip"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_generate_m4()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(day=1, hour=2, minute=0) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
