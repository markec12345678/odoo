<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default structure: monthly salary -->
        <record id="structure_mesecna_placa" model="l10n_si.payroll.structure">
            <field name="name">Mesečna plača (standard)</field>
            <field name="code">MESECNA_PLACA</field>
            <field name="description">Standardna mesečna plača z vsemi prispevki in dohodnino.</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Student work structure -->
        <record id="structure_student" model="l10n_si.payroll.structure">
            <field name="name">Študentsko delo</field>
            <field name="code">STUDENT_DEL0</field>
            <field name="description">Študentsko delo — brez prispevkov, 5% odstavna dohodnina.</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Author contract structure -->
        <record id="structure_avtorska" model="l10n_si.payroll.structure">
            <field name="name">Avtorska pogodba</field>
            <field name="code">AVTORSKA</field>
            <field name="description">Avtorska pogodba z 15% normiranimi stroški.</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Sick leave structure -->
        <record id="structure_bolniska" model="l10n_si.payroll.structure">
            <field name="name">Bolniška</field>
            <field name="code">BOLNISKA</field>
            <field name="description">Nadomestilo plače za čas bolniške.</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
    </data>
</odoo>
