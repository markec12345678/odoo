<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_payroll_structure_tree" model="ir.ui.view">
        <field name="name">l10n_si.payroll.structure.tree</field>
        <field name="model">l10n_si.payroll.structure</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_payroll_structure_form" model="ir.ui.view">
        <field name="name">l10n_si.payroll.structure.form</field>
        <field name="model">l10n_si.payroll.structure</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rules">
                            <field name="rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_payroll_structure" model="ir.actions.act_window">
        <field name="name">Payroll Structures (SI)</field>
        <field name="res_model">l10n_si.payroll.structure</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_si_payroll_root"
              name="Slovenian Payroll"
              parent="hr.menu_hr_root"
              sequence="80"
              groups="hr.group_hr_manager"/>

    <menuitem id="menu_si_payroll_structure"
              name="Structures"
              parent="menu_si_payroll_root"
              action="action_l10n_si_payroll_structure"/>
</odoo>
