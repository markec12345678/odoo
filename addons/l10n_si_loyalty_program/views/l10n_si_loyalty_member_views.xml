<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_loyalty_member_tree" model="ir.ui.view">
        <field name="name">l10n_si.loyalty.member.tree</field>
        <field name="model">l10n_si.loyalty.member</field>
        <field name="arch" type="xml">
            <tree decoration-warning="tier == 'silver'"
                  decoration-success="tier == 'gold'"
                  decoration-info="tier == 'platinum'">
                <field name="number"/>
                <field name="partner_id"/>
                <field name="tier"/>
                <field name="points_balance"/>
                <field name="points_total_earned"/>
                <field name="stay_count"/>
                <field name="joined_on"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_l10n_si_loyalty_member_form" model="ir.ui.view">
        <field name="name">l10n_si.loyalty.member.form</field>
        <field name="model">l10n_si.loyalty.member</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pause" type="object" string="Pavziraj"
                            attrs="{'invisible': [('state', '!=', 'active')]}"/>
                    <button name="action_activate" type="object" string="Aktiviraj"
                            attrs="{'invisible': [('state', '!=', 'paused')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="number" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="tier"/>
                            <field name="tier_achieved_on" readonly="1"/>
                        </group>
                        <group>
                            <field name="points_balance"/>
                            <field name="points_total_earned"/>
                            <field name="points_total_redeemed"/>
                            <field name="joined_on" readonly="1"/>
                            <field name="last_activity" readonly="1"/>
                            <field name="expires_on" readonly="1"/>
                        </group>
                    </group>
                    <group string="Preference">
                        <group>
                            <field name="preferred_room_type_id"/>
                            <field name="dietary_preferences"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transakcije">
                            <field name="transaction_ids" readonly="1">
                                <tree>
                                    <field name="create_date"/>
                                    <field name="points"/>
                                    <field name="transaction_type"/>
                                    <field name="source"/>
                                    <field name="reference"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Statistika">
                            <group>
                                <field name="transaction_count"/>
                                <field name="stay_count"/>
                            </group>
                        </page>
                        <page string="Opombe">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_loyalty_member" model="ir.actions.act_window">
        <field name="name">Člani programa zvestobe</field>
        <field name="res_model">l10n_si.loyalty.member</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
