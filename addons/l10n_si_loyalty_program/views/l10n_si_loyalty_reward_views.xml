<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_loyalty_reward_tree" model="ir.ui.view">
        <field name="name">l10n_si.loyalty.reward.tree</field>
        <field name="model">l10n_si.loyalty.reward</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="reward_type"/>
                <field name="points_required"/>
                <field name="valid_days"/>
                <field name="expires_in_days"/>
                <field name="quantity_redeemed"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_l10n_si_loyalty_reward_form" model="ir.ui.view">
        <field name="name">l10n_si.loyalty.reward.form</field>
        <field name="model">l10n_si.loyalty.reward</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="reward_type"/>
                            <field name="points_required"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="valid_for_room_type_id"/>
                            <field name="valid_days"/>
                            <field name="expires_in_days"/>
                            <field name="quantity_available"/>
                            <field name="quantity_redeemed"/>
                        </group>
                    </group>
                    <group string="Opis">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_loyalty_reward" model="ir.actions.act_window">
        <field name="name">Nagrade</field>
        <field name="res_model">l10n_si.loyalty.reward</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_l10n_si_loyalty_root" name="Program zvestobe" web_icon="l10n_si_loyalty_program,static/description/icon.png" sequence="55"/>
    <menuitem id="menu_l10n_si_loyalty_member" name="Člani" parent="menu_l10n_si_loyalty_root" action="action_l10n_si_loyalty_member"/>
    <menuitem id="menu_l10n_si_loyalty_reward" name="Nagrade" parent="menu_l10n_si_loyalty_root" action="action_l10n_si_loyalty_reward"/>
</odoo>
