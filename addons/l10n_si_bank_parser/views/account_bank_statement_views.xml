<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add informational banner on the bank statement form when imported via SI parser -->
    <record id="view_account_bank_statement_form_si" model="ir.ui.view">
        <field name="name">account.bank.statement.form.si</field>
        <field name="model">account.bank.statement</field>
        <field name="inherit_id" ref="account.view_bank_statement_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info" role="alert"
                     attrs="{'invisible': [('name', 'not like', 'NLB')]}">
                    NLB statement imported. Auto-matching will run on save.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
