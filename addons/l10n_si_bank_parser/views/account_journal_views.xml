<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_si_bank" model="ir.ui.view">
        <field name="name">account.journal.form.si.bank</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bank_acc_number']" position="after">
                <field name="si_bank_format"
                       attrs="{'invisible': [('type', '!=', 'bank')]}"/>
                <field name="si_bank_identifier"
                       attrs="{'invisible': [('type', '!=', 'bank')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
