<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_group_user" model="res.groups">
        <field name="name">SI Helpdesk / User</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="helpdesk_group_manager" model="res.groups">
        <field name="name">SI Helpdesk / Manager</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('helpdesk_group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root'))]"/>
    </record>
</odoo>
