<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_helpdesk_canned_response_tree" model="ir.ui.view">
        <field name="name">l10n_si.helpdesk.canned.response.tree</field>
        <field name="model">l10n_si.helpdesk.canned.response</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_l10n_si_helpdesk_canned_response_form" model="ir.ui.view">
        <field name="name">l10n_si.helpdesk.canned.response.form</field>
        <field name="model">l10n_si.helpdesk.canned.response</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="active"/>
                </group>
                <group>
                    <field name="team_ids" widget="many2many_tags"/>
                </group>
                <group string="Telo odgovora">
                    <field name="body" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_helpdesk_canned_response" model="ir.actions.act_window">
        <field name="name">Canned Responses (SI Helpdesk)</field>
        <field name="res_model">l10n_si.helpdesk.canned.response</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
