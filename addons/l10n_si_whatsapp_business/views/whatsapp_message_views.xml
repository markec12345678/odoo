<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wa_message_list" model="ir.ui.view">
        <field name="name">wa.message.list</field>
        <field name="model">wa.message</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'sent'" decoration-danger="state == 'failed'" decoration-muted="state == 'received'">
                <field name="name"/>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="message_body"/>
                <field name="state"/>
                <field name="direction"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_wa_message_form" model="ir.ui.view">
        <field name="name">wa.message.form</field>
        <field name="model">wa.message</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Send" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_send_template" type="object" string="Send Template" invisible="state != 'draft' or not template_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="partner_id"/>
                            <field name="direction"/>
                        </group>
                        <group>
                            <field name="template_id"/>
                            <field name="wa_message_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message_body" nolabel="1"/>
                    </group>
                    <group string="Error" invisible="state != 'failed'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_wa_message" model="ir.actions.act_window">
        <field name="name">WhatsApp Messages</field>
        <field name="res_model">wa.message</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
