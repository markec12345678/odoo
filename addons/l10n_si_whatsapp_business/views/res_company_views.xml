<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_wa" model="ir.ui.view">
        <field name="name">res.company.form.wa</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="WhatsApp Business API">
                    <field name="wa_enabled"/>
                    <field name="wa_business_phone" invisible="not wa_enabled"/>
                    <field name="wa_phone_number_id" invisible="not wa_enabled"/>
                    <field name="wa_access_token" invisible="not wa_enabled" password="True"/>
                    <field name="wa_verify_token" invisible="not wa_enabled"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
