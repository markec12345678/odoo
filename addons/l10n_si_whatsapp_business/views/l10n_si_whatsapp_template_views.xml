<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wa_tpl_list" model="ir.ui.view">
        <field name="name">l10n_si.whatsapp.template.list</field>
        <field name="model">l10n_si.whatsapp.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="language"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_wa_tpl_form" model="ir.ui.view">
        <field name="name">l10n_si.whatsapp.template.form</field>
        <field name="model">l10n_si.whatsapp.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="language"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Vsebina predloge">
                        <field name="body" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_wa_tpl" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">l10n_si.whatsapp.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
