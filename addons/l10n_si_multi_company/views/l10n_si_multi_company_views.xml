<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_multi_company_tree" model="ir.ui.view">
        <field name="name">l10n_si_multi_company.tree</field>
        <field name="model">l10n_si.hotel.chain</field>
        <field name="arch" type="xml"><tree><field name="number"/><field name="name"/><field name="create_date"/><field name="active"/></tree></field>
    </record>
    <record id="view_l10n_si_multi_company_form" model="ir.ui.view">
        <field name="name">l10n_si_multi_company.form</field>
        <field name="model">l10n_si.hotel.chain</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="number" readonly="1"/><field name="active"/></group><group string="Opombe"><field name="notes" nolabel="1"/></group></sheet></form></field>
    </record>
    <record id="action_l10n_si_multi_company" model="ir.actions.act_window">
        <field name="name">Slovenian Multi-Company</field>
        <field name="res_model">l10n_si.hotel.chain</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_l10n_si_multi_company" name="Slovenian Multi-Company" parent="base.menu_administration" sequence="200" action="action_l10n_si_multi_company"/>
</odoo>
