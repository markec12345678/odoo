<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_hr_evisitor_log_list" model="ir.ui.view">
        <field name="name">l10n_hr.evisitor.log.list</field>
        <field name="model">l10n_hr.evisitor.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="registration_id"/>
                <field name="request_type"/>
                <field name="state"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>
    <record id="action_l10n_hr_evisitor_log" model="ir.actions.act_window">
        <field name="name">eVisitor Logs</field>
        <field name="res_model">l10n_hr.evisitor.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
