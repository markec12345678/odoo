<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_hr_evisitor_accommodation_list" model="ir.ui.view">
        <field name="name">l10n_hr.evisitor.accommodation.list</field>
        <field name="model">l10n_hr.evisitor.accommodation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="accommodation_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_l10n_hr_evisitor_accommodation_form" model="ir.ui.view">
        <field name="name">l10n_hr.evisitor.accommodation.form</field>
        <field name="model">l10n_hr.evisitor.accommodation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="accommodation_type"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_l10n_hr_evisitor_accommodation" model="ir.actions.act_window">
        <field name="name">Accommodations</field>
        <field name="res_model">l10n_hr.evisitor.accommodation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
