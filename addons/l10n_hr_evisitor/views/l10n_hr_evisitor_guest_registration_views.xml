<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_hr_evisitor_guest_registration_list" model="ir.ui.view">
        <field name="name">l10n_hr.evisitor.guest.registration.list</field>
        <field name="model">l10n_hr.evisitor.guest.registration</field>
        <field name="arch" type="xml">
            <list>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="accommodation_id"/>
                <field name="arrival_date"/>
                <field name="departure_date"/>
            </list>
        </field>
    </record>
    <record id="view_l10n_hr_evisitor_guest_registration_form" model="ir.ui.view">
        <field name="name">l10n_hr.evisitor.guest.registration.form</field>
        <field name="model">l10n_hr.evisitor.guest.registration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-danger"/>
                </header>
                <sheet>
                    <group>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="accommodation_id"/>
                        <field name="arrival_date"/>
                        <field name="departure_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_l10n_hr_evisitor_guest_registration" model="ir.actions.act_window">
        <field name="name">Guest Registrations</field>
        <field name="res_model">l10n_hr.evisitor.guest.registration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
