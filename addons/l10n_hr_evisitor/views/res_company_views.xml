<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_evisitor" model="ir.ui.view">
        <field name="name">res.company.form.evisitor</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="HR eVisitor">
                    <field name="l10n_hr_evisitor_environment"/>
                    <field name="auto_register"/>
                    <field name="auto_deregister"/>
                    <field name="notify_on_error"/>
                    <field name="notify_user_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
