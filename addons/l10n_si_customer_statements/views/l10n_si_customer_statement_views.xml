<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_customer_statement_tree" model="ir.ui.view">
        <field name="name">l10n_si.customer.statement.tree</field>
        <field name="model">l10n_si.customer.statement</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="partner_id"/>
                <field name="opening_balance" sum="Skupaj"/>
                <field name="invoiced_amount" sum="Skupaj"/>
                <field name="paid_amount" sum="Skupaj"/>
                <field name="closing_balance" sum="Skupaj"/>
                <field name="aging_90_plus" sum="Skupaj"/>
                <field name="sent"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_customer_statement_form" model="ir.ui.view">
        <field name="name">l10n_si.customer.statement.form</field>
        <field name="model">l10n_si.customer.statement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_email" type="object" string="Pošlji e-pošto" class="btn-primary"
                            invisible="[('sent', '=', True)]"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="opening_balance"/>
                            <field name="invoiced_amount"/>
                            <field name="paid_amount"/>
                            <field name="closing_balance"/>
                            <field name="sent" readonly="1"/>
                            <field name="sent_on" readonly="1"/>
                        </group>
                    </group>
                    <group string="Aging (po zapadlosti)">
                        <group>
                            <field name="aging_0_30"/>
                            <field name="aging_31_60"/>
                        </group>
                        <group>
                            <field name="aging_61_90"/>
                            <field name="aging_90_plus"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Postavke">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="ref"/>
                                    <field name="move_id"/>
                                    <field name="line_type"/>
                                    <field name="debit" sum="Skupaj"/>
                                    <field name="credit" sum="Skupaj"/>
                                    <field name="balance" sum="Skupaj"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_customer_statement" model="ir.actions.act_window">
        <field name="name">SI Customer Statements</field>
        <field name="res_model">l10n_si.customer.statement</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_si_customer_statement" name="Customer Statements"
              parent="account.menu_finance_receivables"
              action="action_l10n_si_customer_statement" sequence="60"/>
</odoo>
