<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_customer_statement_wizard_form" model="ir.ui.view">
        <field name="name">l10n_si.customer.statement.wizard.form</field>
        <field name="model">l10n_si.customer.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Generiraj izpise stanj">
                <group>
                    <field name="year"/>
                    <field name="month"/>
                    <field name="send_email"/>
                </group>
                <group string="Stranke (prazno = vse)">
                    <field name="partner_ids" nolabel="1">
                        <tree>
                            <field name="name"/>
                            <field name="email"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generiraj" class="btn-primary"/>
                    <button special="cancel" string="Prekliči" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_customer_statement_wizard" model="ir.actions.act_window">
        <field name="name">Generate Statements</field>
        <field name="res_model">l10n_si.customer.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_si_customer_statement_wizard" name="Generate Statements"
              parent="account.menu_finance_receivables"
              action="action_l10n_si_customer_statement_wizard" sequence="65"/>
</odoo>
