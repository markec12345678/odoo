<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Monthly auto-generation on 1st of each month for previous period -->
        <record id="cron_si_customer_statement_monthly" model="ir.cron">
            <field name="name">SI Customer Statements: Monthly Generate</field>
            <field name="model_id" ref="model_l10n_si_customer_statement_wizard"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_generate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(day=1, hour=2, minute=0, second=0) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
