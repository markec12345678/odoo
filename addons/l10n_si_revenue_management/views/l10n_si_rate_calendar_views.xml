<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_rate_calendar_tree" model="ir.ui.view">
        <field name="name">l10n_si.rate.calendar.tree</field>
        <field name="model">l10n_si.rate.calendar</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'published'"
                  decoration-muted="state == 'closed'">
                <field name="date"/>
                <field name="rate_plan_id"/>
                <field name="computed_rate"/>
                <field name="override_rate"/>
                <field name="final_rate" sum="Skupaj"/>
                <field name="occupancy_at_compute" widget="percentage"/>
                <field name="closed_to_arrival"/>
                <field name="closed_to_departure"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_rate_calendar_form" model="ir.ui.view">
        <field name="name">l10n_si.rate.calendar.form</field>
        <field name="model">l10n_si.rate.calendar</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_recompute" type="object" string="Preračunaj" class="btn-secondary"/>
                    <button name="action_publish" type="object" string="Objavi" class="btn-primary"
                            invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_close" type="object" string="Zapri"
                            invisible="[('state', '=', 'closed')]"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="rate_plan_id"/>
                        </group>
                        <group>
                            <field name="computed_rate"/>
                            <field name="override_rate"/>
                            <field name="final_rate" widget="monetary"/>
                        </group>
                    </group>
                    <group>
                        <field name="occupancy_at_compute" widget="percentage"/>
                        <field name="applied_factors"/>
                    </group>
                    <group string="Omejitve za ta dan">
                        <group>
                            <field name="closed_to_arrival"/>
                            <field name="closed_to_departure"/>
                        </group>
                        <group>
                            <field name="min_los_override"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_si_rate_calendar_search" model="ir.ui.view">
        <field name="name">l10n_si.rate.calendar.search</field>
        <field name="model">l10n_si.rate.calendar</field>
        <field name="arch" type="xml">
            <search>
                <field name="rate_plan_id"/>
                <filter name="filter_next_7" string="Naslednjih 7 dni"
                        domain="[('date', '&gt;=', context_today()), ('date', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_next_30" string="Naslednjih 30 dni"
                        domain="[('date', '&gt;=', context_today()), ('date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group string="Group By">
                    <filter name="group_plan" string="Cenovni načrt" context="{'group_by': 'rate_plan_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Mesec" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_si_rate_calendar" model="ir.actions.act_window">
        <field name="name">Cenovni koledar</field>
        <field name="res_model">l10n_si.rate.calendar</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
