<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_occupancy_forecast_tree" model="ir.ui.view">
        <field name="name">l10n_si.occupancy.forecast.tree</field>
        <field name="model">l10n_si.occupancy.forecast</field>
        <field name="arch" type="xml">
            <list decoration-success="actual_occupancy &gt;= 80"
                  decoration-warning="actual_occupancy &gt;= 50 and actual_occupancy &lt; 80"
                  decoration-danger="actual_occupancy &lt; 50">
                <field name="date"/>
                <field name="total_rooms"/>
                <field name="confirmed_bookings"/>
                <field name="tentative_bookings"/>
                <field name="forecasted_occupancy" widget="percentage"/>
                <field name="actual_occupancy" widget="percentage"/>
                <field name="variance" widget="percentage"/>
                <field name="forecast_method"/>
            </list>
        </field>
    </record>

    <record id="action_l10n_si_occupancy_forecast" model="ir.actions.act_window">
        <field name="name">Napoved zasedenosti</field>
        <field name="res_model">l10n_si.occupancy.forecast</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_si_revenue_root" name="Revenue Management" parent="l10n_si_hotel.menu_l10n_si_hotel_root" sequence="70"/>
    <menuitem id="menu_l10n_si_rate_plan" name="Cenovni načrti" parent="menu_l10n_si_revenue_root" action="action_l10n_si_rate_plan"/>
    <menuitem id="menu_l10n_si_rate_calendar" name="Cenovni koledar" parent="menu_l10n_si_revenue_root" action="action_l10n_si_rate_calendar"/>
    <menuitem id="menu_l10n_si_occupancy_forecast" name="Napoved zasedenosti" parent="menu_l10n_si_revenue_root" action="action_l10n_si_occupancy_forecast"/>
</odoo>
