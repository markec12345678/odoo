<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_si_revenue_generate_calendar" model="ir.cron">
            <field name="name">SI Revenue: Generate Rate Calendar</field>
            <field name="model_id" ref="model_l10n_si_rate_calendar"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_calendar()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0, second=0) + relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
        <record id="cron_si_revenue_forecast" model="ir.cron">
            <field name="name">SI Revenue: Generate Forecast</field>
            <field name="model_id" ref="model_l10n_si_occupancy_forecast"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_forecast()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=4, minute=0, second=0) + relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
