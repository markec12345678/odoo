<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_hr_account" model="ir.ui.view">
        <field name="name">res.company.form.hr.account</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="court_registration_number" placeholder="MBS"/>
                <field name="court_name"/>
                <field name="share_capital"/>
            </xpath>
        </field>
    </record>
</odoo>
