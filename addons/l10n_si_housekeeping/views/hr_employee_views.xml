<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_si_housekeeping" model="ir.ui.view">
        <field name="name">hr.employee.form.si.housekeeping</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="SI Hišništvo" name="si_housekeeping">
                    <group>
                        <group>
                            <field name="si_is_housekeeper"/>
                            <field name="si_housekeeping_zone"/>
                        </group>
                        <group>
                            <field name="si_cleanings_today" readonly="1"/>
                            <field name="si_cleanings_completed_today" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
