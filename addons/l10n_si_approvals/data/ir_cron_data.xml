<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_si_approval_check_sla" model="ir.cron">
            <field name="name">SI Approvals: SLA check</field>
            <field name="model_id" ref="model_l10n_si_approval_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_sla_breach()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=8, minute=0, second=0) + relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
