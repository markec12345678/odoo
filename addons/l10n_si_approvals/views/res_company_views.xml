<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_si_approvals" model="ir.ui.view">
        <field name="name">res.company.form.si.approvals</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="SI Approvals">
                    <field name="si_approval_sla_days"/>
                    <field name="si_approval_auto_remind"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
