<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_approval_request_tree" model="ir.ui.view">
        <field name="name">l10n_si.approval.request.tree</field>
        <field name="model">l10n_si.approval.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'">
                <field name="number"/>
                <field name="name"/>
                <field name="category"/>
                <field name="requester_employee_id"/>
                <field name="amount"/>
                <field name="current_approver_id"/>
                <field name="state"/>
                <field name="sla_deadline" optional="show"/>
                <field name="sla_breached" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_approval_request_form" model="ir.ui.view">
        <field name="name">l10n_si.approval.request.form</field>
        <field name="model">l10n_si.approval.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Pošlji v odobritev" class="btn-primary"
                            invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_approve" type="object" string="Odobri" class="btn-primary"
                            invisible="[('state', '!=', 'pending')]"/>
                    <button name="action_reject" type="object" string="Zavrni"
                            invisible="[('state', '!=', 'pending')]"/>
                    <button name="action_cancel" type="object" string="Prekliči"
                            invisible="[('state', 'in', ('approved', 'rejected', 'cancelled'))]"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="number"/>
                            <field name="category"/>
                            <field name="requester_employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="days"/>
                            <field name="current_approver_id" readonly="1"/>
                            <field name="sla_deadline" readonly="1"/>
                            <field name="sla_breached" readonly="1"/>
                            <field name="date_approved" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Opis">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Odobritvena veriga">
                            <field name="approver_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="approver_employee_id"/>
                                    <field name="role"/>
                                    <field name="state"/>
                                    <field name="decision_date"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_l10n_si_approval_request_search" model="ir.ui.view">
        <field name="name">l10n_si.approval.request.search</field>
        <field name="model">l10n_si.approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="number"/>
                <field name="requester_employee_id"/>
                <field name="current_approver_id"/>
                <filter name="filter_pending" string="V postopku" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_mine" string="Moji zahtevki" domain="[('requester_user_id', '=', uid)]"/>
                <filter name="filter_to_approve" string="Za odobritev" domain="[('current_approver_id.user_id', '=', uid)]"/>
                <filter name="filter_sla_breach" string="SLA presežen" domain="[('sla_breached', '=', True)]"/>
                <group string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_category" string="Kategorija" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_si_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests (SI)</field>
        <field name="res_model">l10n_si.approval.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_si_approval_request" name="Requests" parent="menu_si_approvals_root"
              action="action_l10n_si_approval_request" sequence="10"/>
</odoo>
