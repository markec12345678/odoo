<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_si_approvals" model="ir.ui.view">
        <field name="name">hr.employee.form.si.approvals</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="SI Approvals" name="si_approvals">
                    <group>
                        <group>
                            <field name="si_can_approve"/>
                            <field name="si_approval_limit"/>
                            <field name="si_approver_for_categories"/>
                        </group>
                        <group>
                            <field name="si_delegate_to_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
