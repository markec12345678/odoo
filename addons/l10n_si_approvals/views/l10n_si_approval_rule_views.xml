<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_approval_rule_tree" model="ir.ui.view">
        <field name="name">l10n_si.approval.rule.tree</field>
        <field name="model">l10n_si.approval.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="min_amount"/>
                <field name="max_amount"/>
                <field name="workflow_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_approval_rule_form" model="ir.ui.view">
        <field name="name">l10n_si.approval.rule.form</field>
        <field name="model">l10n_si.approval.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="min_amount"/>
                            <field name="max_amount"/>
                            <field name="days_min"/>
                            <field name="days_max"/>
                            <field name="workflow_type"/>
                        </group>
                    </group>
                    <group string="Approver Chain">
                        <field name="approver_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="approver_employee_id"/>
                                <field name="role"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_approval_rule" model="ir.actions.act_window">
        <field name="name">Approval Rules (SI)</field>
        <field name="res_model">l10n_si.approval.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_si_approvals_root" name="SI Approvals" parent="base.menu_administration" sequence="100"/>
    <menuitem id="menu_si_approval_rule" name="Rules" parent="menu_si_approvals_root" action="action_l10n_si_approval_rule"/>
</odoo>
