<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- X/Z Report PDF template -->
    <record id="action_report_pos_xz" model="ir.actions.report">
        <field name="name">POS X/Z poročilo</field>
        <field name="model">l10n_si.pos.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_si_pos_advanced.report_pos_xz_document</field>
        <field name="report_file">l10n_si_pos_advanced.report_pos_xz_document</field>
    </record>

    <!-- SI POS Receipt with ZOI/EOR/QR code (termal format) -->
    <record id="action_report_pos_receipt_si" model="ir.actions.report">
        <field name="name">POS račun (SI)</field>
        <field name="model">pos.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_si_pos_advanced.report_pos_receipt_si_document</field>
        <field name="report_file">l10n_si_pos_advanced.report_pos_receipt_si_document</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
