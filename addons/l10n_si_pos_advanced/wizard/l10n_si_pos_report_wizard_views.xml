<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_pos_report_wizard_form" model="ir.ui.view">
        <field name="name">l10n_si.pos.report.wizard.form</field>
        <field name="model">l10n_si.pos.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object" string="Izračunaj" class="oe_highlight"/>
                    <button name="action_print_pdf" type="object" string="Natisni PDF"
                            invisible="total_orders == 0"/>
                    <button name="action_close_session" type="object" string="Zaključi sejo"
                            invisible="report_type != 'z_report' or session_id == False"
                            confirm="Ali ste prepričani, da želite zaključiti POS sejo?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="report_type"/>
                            <field name="config_id"/>
                            <field name="session_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="Skupaj" invisible="total_orders == 0">
                        <group>
                            <field name="total_orders" readonly="1"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="total_vat" readonly="1"/>
                            <field name="total_tourist_tax" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_cash" readonly="1"/>
                            <field name="total_card" readonly="1"/>
                            <field name="total_other" readonly="1"/>
                        </group>
                    </group>
                    <group string="FURS status" invisible="total_orders == 0">
                        <group>
                            <field name="furs_submitted_count" readonly="1"/>
                            <field name="furs_pending_count" readonly="1"/>
                            <field name="furs_error_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="DDV po stopnjah" invisible="total_orders == 0">
                        <field name="vat_breakdown_html" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
