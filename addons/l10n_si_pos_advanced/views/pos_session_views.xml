<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_form_si" model="ir.ui.view">
        <field name="name">pos.session.form.si</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_x_report" type="object" string="X-poročilo"
                        attrs="{'invisible': ['|', ('state', '!=', 'opened'), ('si_x_report_generated', '=', True)]}"/>
                <button name="action_generate_z_report" type="object" string="Z-poročilo (zaključi dan)" class="btn-primary"
                        attrs="{'invisible': ['|', ('state', '!=', 'opened'), ('si_z_report_generated', '=', True)]}"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="SI FURS Statistika">
                    <group>
                        <field name="si_fiscal_count" readonly="1"/>
                        <field name="si_fiscal_errors" readonly="1"/>
                    </group>
                    <group>
                        <field name="si_x_report_date" readonly="1"/>
                        <field name="si_z_report_date" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
