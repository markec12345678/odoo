<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_hr_fiscal" model="ir.ui.view">
        <field name="name">res.company.form.hr_fiscal</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="HR Fiskalizacija" name="l10n_hr_fiscal">
                    <group>
                        <group string="Konfiguracija">
                            <field name="hr_fiscal_enabled"/>
                            <field name="hr_fiscal_environment"/>
                            <field name="hr_fiscal_auto_submit"/>
                        </group>
                        <group string="FINA certifikat">
                            <field name="hr_fiscal_certificate"/>
                            <field name="hr_fiscal_certificate_password" password="True"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
