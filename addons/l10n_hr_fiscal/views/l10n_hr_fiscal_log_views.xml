<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_hr_fiscal_log_tree" model="ir.ui.view">
        <field name="name">l10n_hr.fiscal.log.tree</field>
        <field name="model">l10n_hr.fiscal.log</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'sent'" decoration-danger="state == 'error'">
                <field name="submitted_at"/>
                <field name="move_id"/>
                <field name="request_type"/>
                <field name="state" widget="badge"/>
                <field name="zki"/>
                <field name="jir"/>
            </list>
        </field>
    </record>
    <record id="action_l10n_hr_fiscal_log" model="ir.actions.act_window">
        <field name="name">Dnevnik fiskalizacije</field>
        <field name="res_model">l10n_hr.fiscal.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
