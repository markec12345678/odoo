<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_hr_fiscal" model="ir.ui.view">
        <field name="name">account.move.form.hr_fiscal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="HR Fiskalizacija"
                       attrs="{'invisible': [('l10n_hr_fiscal_state', '=', False)]}">
                    <group>
                        <field name="l10n_hr_zki" readonly="1"/>
                        <field name="l10n_hr_jir" readonly="1"/>
                        <field name="l10n_hr_fiscal_state" readonly="1"/>
                        <field name="l10n_hr_fiscal_submitted_at" readonly="1"/>
                    </group>
                    <group>
                        <field name="l10n_hr_business_premise_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
