<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_feedback_response_tree" model="ir.ui.view">
        <field name="name">l10n_si.feedback.response.tree</field>
        <field name="model">l10n_si.feedback.response</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'completed' and not has_alert"
                  decoration-danger="has_alert"
                  decoration-muted="state == 'expired'">
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="folio_id"/>
                <field name="survey_id"/>
                <field name="overall_score" widget="progressbar"/>
                <field name="sentiment" optional="show"/>
                <field name="has_alert" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="completed_date"/>
            </list>
        </field>
    </record>

    <record id="view_feedback_response_form" model="ir.ui.view">
        <field name="name">l10n_si.feedback.response.form</field>
        <field name="model">l10n_si.feedback.response</field>
        <field name="arch" type="xml">
            <form string="Feedback Response">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="sent,started,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Reference">
                            <field name="token" readonly="1"/>
                            <field name="survey_id"/>
                            <field name="folio_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_anonymous"/>
                        </group>
                        <group string="Activity">
                            <field name="sent_date" readonly="1"/>
                            <field name="started_date" readonly="1"/>
                            <field name="completed_date" readonly="1"/>
                            <field name="overall_score" widget="progressbar"/>
                            <field name="nps_score"/>
                            <field name="has_alert" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Answers" name="answers">
                            <field name="answers_json" readonly="1" widget="ace"/>
                        </page>
                        <page string="AI Sentiment" name="ai">
                            <group>
                                <field name="sentiment" readonly="1"/>
                                <field name="sentiment_summary" readonly="1"/>
                            </group>
                        </page>
                        <page string="Alerts" name="alerts">
                            <field name="alert_ids" readonly="1">
                                <list>
                                    <field name="question_id"/>
                                    <field name="score"/>
                                    <field name="category"/>
                                    <field name="state" widget="badge"/>
                                    <field name="assigned_to"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_feedback_response_search" model="ir.ui.view">
        <field name="name">l10n_si.feedback.response.search</field>
        <field name="model">l10n_si.feedback.response</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="folio_id"/>
                <field name="survey_id"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Pending" name="filter_pending"
                        domain="[('state', 'in', ['sent', 'started'])]"/>
                <filter string="Has Alert" name="filter_alert"
                        domain="[('has_alert', '=', True)]"/>
                <filter string="Today" name="filter_today"
                        domain="[('completed_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter string="Positive" name="filter_positive"
                        domain="[('sentiment', '=', 'positive')]"/>
                <filter string="Negative" name="filter_negative"
                        domain="[('sentiment', '=', 'negative')]"/>
                <group expand="0" string="Group By">
                    <filter string="Survey" name="group_survey"
                            context="{'group_by': 'survey_id'}"/>
                    <filter string="Sentiment" name="group_sentiment"
                            context="{'group_by': 'sentiment'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_feedback_response" model="ir.actions.act_window">
        <field name="name">Feedback Responses</field>
        <field name="res_model">l10n_si.feedback.response</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_feedback_response_search"/>
        <field name="context">{'search_default_filter_today': 1, 'search_default_filter_completed': 1}</field>
    </record>
</odoo>
