<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily: expire stale feedback requests (>7 days old) -->
    <record id="cron_expire_stale_feedback" model="ir.cron">
        <field name="name">Feedback: Expire Stale Responses</field>
        <field name="model_id" ref="model_l10n_si_feedback_response"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_stale()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
