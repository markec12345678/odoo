<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fiskal" model="ir.ui.view">
        <field name="name">account.move.form.fiskal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="fiskal_document_type_id" invisible="move_type not in ['out_invoice', 'out_refund', 'out_receipt']"/>
                <field name="fiskal_discount_reason_id" invisible="move_type not in ['out_invoice', 'out_refund']"/>
            </xpath>
        </field>
    </record>
</odoo>
