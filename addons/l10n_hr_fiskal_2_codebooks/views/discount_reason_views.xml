<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiskal_discount_reason_tree" model="ir.ui.view">
        <field name="name">l10n_hr.fiskal.discount.reason.tree</field>
        <field name="model">l10n_hr.fiskal.discount.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="name_hr"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_fiskal_discount_reason_form" model="ir.ui.view">
        <field name="name">l10n_hr.fiskal.discount.reason.form</field>
        <field name="model">l10n_hr.fiskal.discount.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="name_hr"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fiskal_discount_reason" model="ir.actions.act_window">
        <field name="name">Discount Reasons (UNTDID 5189)</field>
        <field name="res_model">l10n_hr.fiskal.discount.reason</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
