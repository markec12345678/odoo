<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ TEMPLATE: TREE ============ -->
    <record id="view_questionnaire_template_tree" model="ir.ui.view">
        <field name="name">l10n_si.questionnaire.template.tree</field>
        <field name="model">l10n_si.questionnaire.template</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="estimated_minutes"/>
                <field name="response_count"/>
                <field name="completed_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- ============ TEMPLATE: FORM ============ -->
    <record id="view_questionnaire_template_form" model="ir.ui.view">
        <field name="name">l10n_si.questionnaire.template.form</field>
        <field name="model">l10n_si.questionnaire.template</field>
        <field name="arch" type="xml">
            <form string="Questionnaire Template">
                <header>
                    <button name="action_preview" type="object" string="Preview"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_responses" icon="fa-list">
                            <field name="response_count" widget="statinfo" string="Responses"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="not active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="estimated_minutes"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="welcome_text"/>
                            <field name="thank_you_text"/>
                        </group>
                    </group>
                    <field name="description" widget="html"/>
                    <notebook>
                        <page string="Sections &amp; Questions" name="sections">
                            <field name="section_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="question_count"/>
                                </tree>
                            </field>
                            <field name="section_ids" invisible="1">
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="sequence"/>
                                            <field name="description"/>
                                        </group>
                                        <notebook>
                                            <page string="Questions" name="questions">
                                                <field name="question_ids" context="{'default_section_id': id}">
                                                    <tree editable="bottom">
                                                        <field name="sequence" widget="handle"/>
                                                        <field name="name"/>
                                                        <field name="question_type"/>
                                                        <field name="is_required"/>
                                                        <field name="storage_field"/>
                                                        <field name="options_raw" invisible="not question_type in ['single_select', 'multi_select']"/>
                                                        <field name="help_text"/>
                                                    </tree>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============ TEMPLATE: SEARCH ============ -->
    <record id="view_questionnaire_template_search" model="ir.ui.view">
        <field name="name">l10n_si.questionnaire.template.search</field>
        <field name="model">l10n_si.questionnaire.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ============ ACTION ============ -->
    <record id="action_questionnaire_template" model="ir.actions.act_window">
        <field name="name">Questionnaire Templates</field>
        <field name="res_model">l10n_si.questionnaire.template</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_questionnaire_template_search"/>
    </record>
</odoo>
