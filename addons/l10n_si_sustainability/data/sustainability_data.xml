<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_si_sustainability_monthly" model="ir.cron">
            <field name="name">SI Sustainability: Monthly reminder</field>
            <field name="model_id" ref="model_l10n_si_sustainability_metric"/>
            <field name="state">code</field>
            <field name="code">model._cron_monthly_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(day=1, hour=8, minute=0, second=0) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
