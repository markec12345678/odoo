<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_concierge_tree" model="ir.ui.view">
        <field name="name">l10n_si.concierge.request.tree</field>
        <field name="model">l10n_si.concierge.request</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'completed'" decoration-danger="priority == '2'">
                <field name="number"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="request_type"/>
                <field name="priority" widget="priority"/>
                <field name="cost"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_l10n_si_concierge_form" model="ir.ui.view">
        <field name="name">l10n_si.concierge.request.form</field>
        <field name="model">l10n_si.concierge.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Začni" attrs="{'invisible': [('state', '!=', 'new')]}"/>
                    <button name="action_complete" type="object" string="Opravi" class="btn-primary" attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                    <button name="action_cancel" type="object" string="Prekliči" attrs="{'invisible': [('state', 'in', ('completed', 'cancelled'))]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="priority" widget="priority"/>
                    <group>
                        <group>
                            <field name="number" readonly="1"/>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="hotel_folio_id"/>
                            <field name="request_type"/>
                        </group>
                        <group>
                            <field name="cost"/>
                            <field name="charge_to_folio"/>
                            <field name="handled_by"/>
                            <field name="completed_on" readonly="1"/>
                        </group>
                    </group>
                    <group string="Opis">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_l10n_si_concierge" model="ir.actions.act_window">
        <field name="name">Concierge zahteve</field>
        <field name="res_model">l10n_si.concierge.request</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_l10n_si_concierge_root" name="Concierge" parent="l10n_si_hotel.menu_l10n_si_hotel_root" sequence="55"/>
    <menuitem id="menu_l10n_si_concierge" name="Zahteve" parent="menu_l10n_si_concierge_root" action="action_l10n_si_concierge"/>
</odoo>
