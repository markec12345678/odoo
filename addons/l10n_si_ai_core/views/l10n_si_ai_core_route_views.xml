<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Route list view -->
    <record id="view_l10n_si_ai_core_route_list" model="ir.ui.view">
        <field name="name">l10n_si.ai.core.route.list</field>
        <field name="model">l10n_si.ai.core.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="task_type"/>
                <field name="temperature"/>
                <field name="max_tokens"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Route form view -->
    <record id="view_l10n_si_ai_core_route_form" model="ir.ui.view">
        <field name="name">l10n_si.ai.core.route.form</field>
        <field name="model">l10n_si.ai.core.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="task_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="temperature"/>
                            <field name="max_tokens"/>
                        </group>
                    </group>
                    <group string="Sistemski prompt">
                        <field name="system_prompt" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Provider list view -->
    <record id="view_l10n_si_ai_core_provider_list" model="ir.ui.view">
        <field name="name">l10n_si.ai.core.provider.list</field>
        <field name="model">l10n_si.ai.core.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="backend"/>
                <field name="model_name"/>
                <field name="task_type"/>
                <field name="priority"/>
                <field name="max_tokens_override"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Provider form view -->
    <record id="view_l10n_si_ai_core_provider_form" model="ir.ui.view">
        <field name="name">l10n_si.ai.core.provider.form</field>
        <field name="model">l10n_si.ai.core.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="backend" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="task_type"/>
                            <field name="priority"/>
                            <field name="max_tokens_override"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_l10n_si_ai_core_route" model="ir.actions.act_window">
        <field name="name">AI Routes</field>
        <field name="res_model">l10n_si.ai.core.route</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_l10n_si_ai_core_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">l10n_si.ai.core.provider</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_l10n_si_ai_core_root" name="AI Core" parent="base.menu_administration" sequence="85"/>
    <menuitem id="menu_l10n_si_ai_core_routes" name="Routes" parent="menu_l10n_si_ai_core_root" action="action_l10n_si_ai_core_route" sequence="10"/>
    <menuitem id="menu_l10n_si_ai_core_providers" name="Providers" parent="menu_l10n_si_ai_core_root" action="action_l10n_si_ai_core_provider" sequence="20"/>
</odoo>
