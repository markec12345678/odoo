<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_ocr_upload_wizard_form" model="ir.ui.view">
        <field name="name">l10n_si.ocr.upload.wizard.form</field>
        <field name="model">l10n_si.ocr.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload za OCR">
                <group>
                    <field name="name"/>
                    <field name="pdf_file" filename="pdf_filename"/>
                    <field name="pdf_filename" invisible="1"/>
                    <field name="auto_create_bill"/>
                </group>
                <footer>
                    <button name="action_upload_and_ocr" type="object" string="Upload + OCR" class="btn-primary"/>
                    <button special="cancel" string="Prekliči" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_ocr_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Invoice for OCR</field>
        <field name="res_model">l10n_si.ocr.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_si_ocr_upload" name="Upload" parent="menu_si_ocr_root" action="action_l10n_si_ocr_upload_wizard"/>
</odoo>
