<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_marketing_campaign_tree" model="ir.ui.view">
        <field name="name">l10n_si.marketing.campaign.tree</field>
        <field name="model">l10n_si.marketing.campaign</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'running'"
                  decoration-muted="state == 'completed'"
                  decoration-warning="state == 'paused'">
                <field name="name"/>
                <field name="trigger"/>
                <field name="participant_count"/>
                <field name="sent_count"/>
                <field name="open_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_marketing_campaign_form" model="ir.ui.view">
        <field name="name">l10n_si.marketing.campaign.form</field>
        <field name="model">l10n_si.marketing.campaign</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Zaženi" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_pause" type="object" string="Pavziraj"
                            attrs="{'invisible': [('state', '!=', 'running')]}"/>
                    <button name="action_start" type="object" string="Nadaljuj"
                            attrs="{'invisible': [('state', '!=', 'paused')]}"/>
                    <button name="action_add_participants" type="object" string="Dodaj udeležence"
                            attrs="{'invisible': [('state', '=', 'completed')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="trigger"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="participant_count" readonly="1"/>
                            <field name="sent_count" readonly="1"/>
                            <field name="open_count" readonly="1"/>
                            <field name="click_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Filter udeležencev">
                        <field name="domain" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Koraki">
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="action_type"/>
                                    <field name="template_id" attrs="{'invisible': [('action_type', '!=', 'email')]}"/>
                                    <field name="wait_days" attrs="{'invisible': [('action_type', '!=', 'wait')]}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Udeleženci">
                            <field name="participant_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="state"/>
                                    <field name="email_sent_count"/>
                                    <field name="email_open_count"/>
                                    <field name="added_on"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_marketing_campaign" model="ir.actions.act_window">
        <field name="name">Marketing Campaigns (SI)</field>
        <field name="res_model">l10n_si.marketing.campaign</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_si_marketing_root" name="SI Marketing" parent="mass_mailing.mass_mailing_menu_root" sequence="20"/>
    <menuitem id="menu_si_marketing_campaign" name="Campaigns" parent="menu_si_marketing_root" action="action_l10n_si_marketing_campaign"/>
</odoo>
