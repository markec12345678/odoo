<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend company form with SI VAT configuration panel -->
    <record id="view_company_form_si_vat" model="ir.ui.view">
        <field name="name">res.company.form.si.vat</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Slovenian VAT Validation (FURS)"
                       name="si_vat_group"
                       invisible="[('country_id', '=', False)]">
                    <group>
                        <field name="si_vat_check_enabled"/>
                        <field name="si_vat_endpoint"
                               invisible="[('si_vat_check_enabled', '=', False)]" required="[('si_vat_check_enabled', '=', True)]"/>
                    </group>
                    <group>
                        <field name="si_furs_certificate" filename="si_furs_certificate_filename"
                               invisible="[('si_vat_check_enabled', '=', False)]"/>
                        <field name="si_furs_certificate_filename" invisible="1"/>
                        <field name="si_furs_certificate_password" password="True"
                               invisible="[('si_vat_check_enabled', '=', False)]"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
