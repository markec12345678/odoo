<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_payment_transaction_tree" model="ir.ui.view">
        <field name="name">l10n_si.payment.transaction.tree</field>
        <field name="model">l10n_si.payment.transaction</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'completed'"
                  decoration-danger="state == 'failed'"
                  decoration-info="state == 'pending'"
                  decoration-muted="state in ('cancelled', 'refunded')">
                <field name="name"/>
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="config_id"/>
                <field name="amount" sum="Skupaj"/>
                <field name="fee_amount" sum="Provizija"/>
                <field name="net_amount" sum="Neto"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_l10n_si_payment_transaction_form" model="ir.ui.view">
        <field name="name">l10n_si.payment.transaction.form</field>
        <field name="model">l10n_si.payment.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_initiate" type="object" string="Zaženi" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_complete" type="object" string="Zaključi"
                            attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <button name="action_refund" type="object" string="Vrni"
                            attrs="{'invisible': ['|', ('state', '!=', 'completed'), ('config_id.supports_refund', '=', False)]}"/>
                    <button name="action_fail" type="object" string="Označi neuspešno"
                            attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <button name="action_cancel" type="object" string="Prekliči"
                            attrs="{'invisible': [('state', 'in', ('completed', 'cancelled', 'refunded'))]}"/>
                    <button name="action_generate_payment_link" type="object" string="Generiraj plačilni link"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="config_id"/>
                            <field name="partner_id"/>
                            <field name="move_id"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary"/>
                            <field name="fee_amount" widget="monetary" readonly="1"/>
                            <field name="net_amount" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="initiated_on" readonly="1"/>
                            <field name="completed_on" readonly="1"/>
                            <field name="refunded_on" readonly="1"/>
                        </group>
                        <group>
                            <field name="external_transaction_id" readonly="1"/>
                            <field name="payment_url" readonly="1"/>
                            <field name="requires_3ds"/>
                            <field name="_3ds_authenticated"/>
                        </group>
                    </group>
                    <group string="Napaka" attrs="{'invisible': [('error_message', '=', False)]}">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <group string="Opombe">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_payment_transaction" model="ir.actions.act_window">
        <field name="name">Plačilne transakcije</field>
        <field name="res_model">l10n_si.payment.transaction</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_l10n_si_payment_root" name="Plačila (SI)" parent="account.menu_finance_configuration" sequence="110"/>
    <menuitem id="menu_l10n_si_payment_config" name="Procesorji" parent="menu_l10n_si_payment_root" action="action_l10n_si_payment_config"/>
    <menuitem id="menu_l10n_si_payment_transaction" name="Transakcije" parent="menu_l10n_si_payment_root" action="action_l10n_si_payment_transaction"/>
</odoo>
