<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nkd_code_tree" model="ir.ui.view">
        <field name="name">l10n_hr.nkd.code.tree</field>
        <field name="model">l10n_hr.nkd.code</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="name_hr"/>
                <field name="section"/>
                <field name="level"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_nkd_code_form" model="ir.ui.view">
        <field name="name">l10n_hr.nkd.code.form</field>
        <field name="model">l10n_hr.nkd.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name_hr"/>
                            <field name="section"/>
                            <field name="section_name"/>
                            <field name="division"/>
                            <field name="level"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_nkd_code_search" model="ir.ui.view">
        <field name="name">l10n_hr.nkd.code.search</field>
        <field name="model">l10n_hr.nkd.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="name_hr"/>
                <group expand="0" string="Group By">
                    <filter string="Section" name="group_section"
                            context="{'group_by': 'section'}"/>
                    <filter string="Level" name="group_level"
                            context="{'group_by': 'level'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_nkd_code" model="ir.actions.act_window">
        <field name="name">NKD Activity Codes</field>
        <field name="res_model">l10n_hr.nkd.code</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_nkd_code_search"/>
    </record>
</odoo>
