<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_rate_limit_config_list" model="ir.ui.view">
        <field name="name">l10n_si.rate.limit.config.list</field>
        <field name="model">l10n_si.rate.limit.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="endpoint"/>
                <field name="max_requests"/>
                <field name="window_seconds"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_rate_limit_config_form" model="ir.ui.view">
        <field name="name">l10n_si.rate.limit.config.form</field>
        <field name="model">l10n_si.rate.limit.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="endpoint"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="max_requests"/>
                            <field name="window_seconds"/>
                        </group>
                    </group>
                    <group string="Whitelisted IPs (one per line)">
                        <field name="whitelisted_ips" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_rate_limit_config" model="ir.actions.act_window">
        <field name="name">Rate Limit Configurations</field>
        <field name="res_model">l10n_si.rate.limit.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_si_rate_limit_root" name="Rate Limits" parent="base.menu_administration" sequence="90"/>
    <menuitem id="menu_l10n_si_rate_limit_config" name="Configurations" parent="menu_l10n_si_rate_limit_root" action="action_l10n_si_rate_limit_config" sequence="10"/>
</odoo>
