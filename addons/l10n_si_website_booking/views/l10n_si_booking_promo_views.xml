<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_booking_promo_tree" model="ir.ui.view">
        <field name="name">l10n_si.booking.promo.tree</field>
        <field name="model">l10n_si.booking.promo</field>
        <field name="arch" type="xml">
            <tree decoration-success="active == True" decoration-muted="active == False">
                <field name="code"/>
                <field name="name"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="uses_count"/>
                <field name="max_uses"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_l10n_si_booking_promo_form" model="ir.ui.view">
        <field name="name">l10n_si.booking.promo.form</field>
        <field name="model">l10n_si.booking.promo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="min_nights"/>
                        </group>
                    </group>
                    <group string="Veljavnost">
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                        </group>
                        <group>
                            <field name="max_uses"/>
                            <field name="uses_count"/>
                            <field name="uses_remaining"/>
                        </group>
                    </group>
                    <group string="Omejitve">
                        <group>
                            <field name="min_days_before_arrival"/>
                            <field name="max_days_before_arrival"/>
                        </group>
                        <group>
                            <field name="valid_room_type_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Zgodovina uporabe">
                            <field name="usage_history_ids" readonly="1">
                                <tree>
                                    <field name="create_date"/>
                                    <field name="partner_id"/>
                                    <field name="discount_amount"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Opis">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_booking_promo" model="ir.actions.act_window">
        <field name="name">Promo kode</field>
        <field name="res_model">l10n_si.booking.promo</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_l10n_si_booking_root" name="Spletni booking" parent="website.menu_website_configuration" sequence="50"/>
    <menuitem id="menu_l10n_si_booking_promo" name="Promo kode" parent="menu_l10n_si_booking_root" action="action_l10n_si_booking_promo"/>
</odoo>
