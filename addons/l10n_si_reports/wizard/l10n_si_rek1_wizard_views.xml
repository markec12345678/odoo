<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_rek1_wizard_form" model="ir.ui.view">
        <field name="name">l10n_si.rek1.wizard.form</field>
        <field name="model">l10n_si.rek1.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id"/>
                    <field name="year"/>
                    <field name="month"/>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate XML" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_rek1_wizard" model="ir.actions.act_window">
        <field name="name">REK-1 Monthly Report</field>
        <field name="res_model">l10n_si.rek1.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_l10n_si_rek1"
              name="REK-1 (Monthly Buyers)"
              parent="menu_l10n_si_reports_root"
              action="action_l10n_si_rek1_wizard"
              sequence="20"/>
</odoo>
