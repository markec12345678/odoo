<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_m4_wizard_form" model="ir.ui.view">
        <field name="name">l10n_si.m4.wizard.form</field>
        <field name="model">l10n_si.m4.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate M4 Report">
                <group>
                    <field name="company_id"/>
                    <field name="year"/>
                    <field name="month"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    M4 requires either the Slovenian payroll module (Enterprise)
                    or manual payslip entry. The wizard will search for posted
                    <code>hr.payslip</code> records in the selected period.
                </div>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate XML" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_m4_wizard" model="ir.actions.act_window">
        <field name="name">M4 Monthly Income Tax Prepayment</field>
        <field name="res_model">l10n_si.m4.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_l10n_si_m4"
              name="M4 (Monthly Payroll Tax)"
              parent="menu_l10n_si_reports_root"
              action="action_l10n_si_m4_wizard"
              sequence="30"/>
</odoo>
