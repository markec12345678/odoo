<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_review_tree" model="ir.ui.view">
        <field name="name">l10n_si.review.tree</field>
        <field name="model">l10n_si.review</field>
        <field name="arch" type="xml">
            <list decoration-success="sentiment in ('very_positive', 'positive')"
                  decoration-danger="sentiment in ('very_negative', 'negative')"
                  decoration-warning="state == 'new'">
                <field name="number"/>
                <field name="review_date"/>
                <field name="guest_name"/>
                <field name="source_platform"/>
                <field name="rating"/>
                <field name="rating_normalized"/>
                <field name="sentiment"/>
                <field name="detected_categories"/>
                <field name="is_responded"/>
                <field name="response_time_hours" widget="float_time"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_review_form" model="ir.ui.view">
        <field name="name">l10n_si.review.form</field>
        <field name="model">l10n_si.review</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_analyze_sentiment" type="object" string="AI analiza" class="btn-secondary"
                            invisible="[('state', '!=', 'new')]"/>
                    <button name="action_generate_ai_response" type="object" string="AI predlog odgovora" class="btn-secondary"
                            invisible="[('state', 'in', ('responded', 'archived'))]"/>
                    <button name="action_respond" type="object" string="Pošlji odgovor" class="btn-primary"
                            invisible="['|', ('response_text', '=', False), ('state', '=', 'responded')]"/>
                    <button name="action_escalate" type="object" string="Prenesi na vodjo"
                            invisible="[('state', 'in', ('responded', 'archived'))]"/>
                    <button name="action_archive" type="object" string="Arhiviraj"
                            invisible="[('state', '=', 'archived')]"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="number" readonly="1"/>
                            <field name="source_id"/>
                            <field name="source_platform" readonly="1"/>
                            <field name="external_review_id" readonly="1"/>
                            <field name="guest_name"/>
                            <field name="partner_id"/>
                            <field name="guest_country_id"/>
                        </group>
                        <group>
                            <field name="review_date"/>
                            <field name="stay_date"/>
                            <field name="visit_type"/>
                            <field name="rating"/>
                            <field name="rating_normalized" widget="percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ocena gosta">
                            <group>
                                <field name="title"/>
                                <field name="body" nolabel="1"/>
                            </group>
                        </page>
                        <page string="AI analiza">
                            <group>
                                <field name="sentiment"/>
                                <field name="detected_categories"/>
                                <field name="ai_summary"/>
                            </group>
                        </page>
                        <page string="Naš odgovor">
                            <field name="response_text" nolabel="1"/>
                            <group>
                                <field name="response_author_id" readonly="1"/>
                                <field name="responded_on" readonly="1"/>
                                <field name="response_time_hours" widget="float_time" readonly="1"/>
                            </group>
                        </page>
                        <page string="Slike">
                            <field name="image_ids">
                                <list>
                                    <field name="image" widget="image"/>
                                    <field name="caption"/>
                                </list>
                            </field>
                        </page>
                        <page string="Povezave">
                            <group>
                                <field name="hotel_folio_id"/>
                                <field name="hotel_reservation_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_l10n_si_review_search" model="ir.ui.view">
        <field name="name">l10n_si.review.search</field>
        <field name="model">l10n_si.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="number"/>
                <field name="guest_name"/>
                <field name="body"/>
                <field name="source_id"/>
                <filter name="filter_new" string="Nove" domain="[('state', '=', 'new')]"/>
                <filter name="filter_not_responded" string="Brez odgovora" domain="[('is_responded', '=', False)]"/>
                <filter name="filter_negative" string="Negativne" domain="[('sentiment', 'in', ('negative', 'very_negative'))]"/>
                <filter name="filter_low_rating" string="Nizka ocena (1-3)" domain="[('rating', 'in', ('1', '2', '3'))]"/>
                <group string="Group By">
                    <filter name="group_platform" string="Platforma" context="{'group_by': 'source_platform'}"/>
                    <filter name="group_sentiment" string="Sentiment" context="{'group_by': 'sentiment'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Mesec" context="{'group_by': 'review_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_si_review" model="ir.actions.act_window">
        <field name="name">Ocene gostov</field>
        <field name="res_model">l10n_si.review</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
