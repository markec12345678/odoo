<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_review_source_tree" model="ir.ui.view">
        <field name="name">l10n_si.review.source.tree</field>
        <field name="model">l10n_si.review.source</field>
        <field name="arch" type="xml">
            <list decoration-success="last_sync_status == 'success'"
                  decoration-danger="last_sync_status == 'error'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="platform"/>
                <field name="hotel_id_on_platform"/>
                <field name="sync_frequency_hours"/>
                <field name="review_count"/>
                <field name="average_rating"/>
                <field name="last_sync"/>
                <field name="last_sync_status"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_review_source_form" model="ir.ui.view">
        <field name="name">l10n_si.review.source.form</field>
        <field name="model">l10n_si.review.source</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="platform"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="sync_frequency_hours"/>
                            <field name="last_sync" readonly="1"/>
                            <field name="last_sync_status" readonly="1"/>
                            <field name="last_error" readonly="1"/>
                        </group>
                    </group>
                    <group string="API poverilnice" attrs="{'invisible': [('platform', '=', 'internal')]}">
                        <group>
                            <field name="api_endpoint"/>
                            <field name="api_username"/>
                            <field name="api_password" password="True"/>
                        </group>
                        <group>
                            <field name="api_key" password="True"/>
                            <field name="hotel_id_on_platform"/>
                        </group>
                    </group>
                    <group string="Statistika">
                        <group>
                            <field name="review_count"/>
                            <field name="average_rating"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_review_source" model="ir.actions.act_window">
        <field name="name">Viri ocen</field>
        <field name="res_model">l10n_si.review.source</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_si_review_root" name="Ocene gostov" web_icon="l10n_si_review_management,static/description/icon.png" sequence="60"/>
    <menuitem id="menu_l10n_si_review" name="Ocene" parent="menu_l10n_si_review_root" action="action_l10n_si_review"/>
    <menuitem id="menu_l10n_si_review_source" name="Viri ocen" parent="menu_l10n_si_review_root" action="action_l10n_si_review_source" sequence="90"/>
</odoo>
