<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_l10n_si_review" model="ir.sequence">
            <field name="name">SI Review</field>
            <field name="code">l10n_si.review</field>
            <field name="prefix">RVW/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="cron_si_review_sync_sources" model="ir.cron">
            <field name="name">SI Reviews: Sync from external sources</field>
            <field name="model_id" ref="model_l10n_si_review_source"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_all_sources()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Default internal review source -->
        <record id="review_source_internal" model="l10n_si.review.source">
            <field name="name">Interni obrazec</field>
            <field name="platform">internal</field>
            <field name="sequence">100</field>
        </record>
    </data>
</odoo>
