<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_fleet_fuel_tree" model="ir.ui.view">
        <field name="name">l10n_si.fleet.fuel.tree</field>
        <field name="model">l10n_si.fleet.fuel</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="fuel_type"/>
                <field name="volume" sum="Skupaj"/>
                <field name="price_per_unit"/>
                <field name="total_cost" sum="Skupaj strošek"/>
                <field name="odometer"/>
                <field name="fuel_station"/>
            </tree>
        </field>
    </record>

    <record id="view_l10n_si_fleet_fuel_form" model="ir.ui.view">
        <field name="name">l10n_si.fleet.fuel.form</field>
        <field name="model">l10n_si.fleet.fuel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="date"/>
                            <field name="fuel_type"/>
                        </group>
                        <group>
                            <field name="volume"/>
                            <field name="price_per_unit"/>
                            <field name="total_cost"/>
                            <field name="odometer"/>
                            <field name="fuel_station"/>
                            <field name="invoice_number"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_fleet_fuel" model="ir.actions.act_window">
        <field name="name">Gorivo (SI)</field>
        <field name="res_model">l10n_si.fleet.fuel</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_si_fleet_fuel"
              name="Gorivo"
              parent="fleet.fleet_vehicles"
              action="action_l10n_si_fleet_fuel"
              sequence="30"/>
</odoo>
