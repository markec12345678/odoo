<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_event_contract_template_tree" model="ir.ui.view">
        <field name="name">l10n_si.event.contract.template.tree</field>
        <field name="model">l10n_si.event.contract.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="contract_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_event_contract_template_form" model="ir.ui.view">
        <field name="name">l10n_si.event.contract.template.form</field>
        <field name="model">l10n_si.event.contract.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="contract_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Vsebina (HTML z {{placeholder}})">
                        <field name="body" nolabel="1" widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_event_contract_template" model="ir.actions.act_window">
        <field name="name">Predloge pogodb</field>
        <field name="res_model">l10n_si.event.contract.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
