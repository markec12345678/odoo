<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add bank code field to res.bank form (if not exists) -->
    <record id="view_res_bank_form_hr_code" model="ir.ui.view">
        <field name="name">res.bank.form.hr.code</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bic']" position="before">
                <field name="code" placeholder="HR 7-digit code"/>
            </xpath>
        </field>
    </record>
</odoo>
