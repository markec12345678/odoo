<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_l10n_si_wellness_booking" model="ir.sequence">
            <field name="name">SI Wellness Booking</field>
            <field name="code">l10n_si.wellness.booking</field>
            <field name="prefix">WEL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_l10n_si_wellness_pass" model="ir.sequence">
            <field name="name">SI Wellness Pass</field>
            <field name="code">l10n_si.wellness.pass</field>
            <field name="prefix">PASS/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
