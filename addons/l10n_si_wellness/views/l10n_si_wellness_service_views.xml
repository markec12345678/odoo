<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_wellness_service_tree" model="ir.ui.view">
        <field name="name">l10n_si.wellness.service.tree</field>
        <field name="model">l10n_si.wellness.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="duration_minutes"/>
                <field name="price_adult"/>
                <field name="price_child"/>
                <field name="price_senior"/>
                <field name="booking_count_today"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_l10n_si_wellness_service_form" model="ir.ui.view">
        <field name="name">l10n_si.wellness.service.form</field>
        <field name="model">l10n_si.wellness.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="product_id"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="duration_minutes"/>
                            <field name="capacity"/>
                            <field name="is_group_activity"/>
                            <field name="location"/>
                        </group>
                    </group>
                    <group string="Cene">
                        <group>
                            <field name="price_adult"/>
                            <field name="price_child"/>
                        </group>
                        <group>
                            <field name="price_senior"/>
                            <field name="price_student"/>
                        </group>
                    </group>
                    <group string="Terapevt">
                        <group>
                            <field name="requires_therapist"/>
                            <field name="therapist_role" attrs="{'invisible': [('requires_therapist', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Opis">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_wellness_service" model="ir.actions.act_window">
        <field name="name">Storitve</field>
        <field name="res_model">l10n_si.wellness.service</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
