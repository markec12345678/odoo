<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_event_eq_rental_tree" model="ir.ui.view">
        <field name="name">l10n_si.event.equipment.rental.tree</field>
        <field name="model">l10n_si.event.equipment.rental</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'confirmed'"
                  decoration-success="state == 'returned'">
                <field name="name"/>
                <field name="event_id"/>
                <field name="partner_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="duration_hours" widget="float_time"/>
                <field name="total_amount" sum="Skupaj"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_l10n_si_event_eq_rental_form" model="ir.ui.view">
        <field name="name">l10n_si.event.equipment.rental.form</field>
        <field name="model">l10n_si.event.equipment.rental</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Potrdi" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_start" type="object" string="Začni najem"
                            attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_return" type="object" string="Vrni + Račun" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                    <button name="action_cancel" type="object" string="Prekliči"
                            attrs="{'invisible': [('state', 'in', ('returned', 'cancelled'))]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="event_id"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="duration_hours" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Oprema">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="equipment_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Tehnična podpora">
                            <group>
                                <field name="needs_technician"/>
                                <field name="technician_id" attrs="{'invisible': [('needs_technician', '=', False)], 'required': [('needs_technician', '=', True)]}"/>
                                <field name="technician_hours" attrs="{'invisible': [('needs_technician', '=', False)]}"/>
                                <field name="technician_hourly_rate" attrs="{'invisible': [('needs_technician', '=', False)]}"/>
                                <field name="technician_cost" widget="monetary" readonly="1" attrs="{'invisible': [('needs_technician', '=', False)]}"/>
                            </group>
                        </page>
                    </notebook>
                    <group class="oe_total">
                        <group/>
                        <group class="oe_subtotal_footer oe_right">
                            <field name="total_amount" widget="monetary" class="oe_subtotal_footer_separator"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_event_eq_rental" model="ir.actions.act_window">
        <field name="name">Najem opreme</field>
        <field name="res_model">l10n_si.event.equipment.rental</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_l10n_si_event_eq_root" name="Najem opreme" parent="l10n_si_event_venue.menu_l10n_si_event_venue_root" sequence="50"/>
    <menuitem id="menu_l10n_si_event_eq_rental" name="Najemi" parent="menu_l10n_si_event_eq_root" action="action_l10n_si_event_eq_rental"/>
    <menuitem id="menu_l10n_si_event_equipment" name="Katalog opreme" parent="menu_l10n_si_event_eq_root" action="action_l10n_si_event_equipment"/>
</odoo>
