<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_audit_tree" model="ir.ui.view">
        <field name="name">l10n_si.audit.trail.tree</field>
        <field name="model">l10n_si.audit.trail</field>
        <field name="arch" type="xml"><tree><field name="create_date"/><field name="user_id"/><field name="model_name"/><field name="record_name"/><field name="field_name"/><field name="action_type"/></tree></field>
    </record>
    <record id="view_l10n_si_audit_form" model="ir.ui.view">
        <field name="name">l10n_si.audit.trail.form</field>
        <field name="model">l10n_si.audit.trail</field>
        <field name="arch" type="xml"><form><sheet><group><group><field name="user_id"/><field name="model_name"/><field name="record_id"/><field name="record_name"/><field name="action_type"/></group><group><field name="field_name"/><field name="old_value"/><field name="new_value"/><field name="ip_address"/></group></group></sheet></form></field>
    </record>
    <record id="action_l10n_si_audit" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">l10n_si.audit.trail</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_l10n_si_audit" name="Audit Trail" parent="base.menu_administration" sequence="200" action="action_l10n_si_audit"/>
</odoo>
