<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_l10n_si_camping_reservation" model="ir.sequence">
            <field name="name">SI Camping Reservation</field>
            <field name="code">l10n_si.camping.reservation</field>
            <field name="prefix">KMP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- Default seasons (example for Slovenia 2025) -->
        <record id="season_low" model="l10n_si.camping.season">
            <field name="name">Nizka sezona</field>
            <field name="code">low</field>
            <field name="date_from">2025-01-01</field>
            <field name="date_to">2025-04-30</field>
            <field name="multiplier">0.7</field>
        </record>
        <record id="season_shoulder" model="l10n_si.camping.season">
            <field name="name">Prelivna sezona</field>
            <field name="code">shoulder</field>
            <field name="date_from">2025-05-01</field>
            <field name="date_to">2025-06-30</field>
            <field name="multiplier">1.0</field>
        </record>
        <record id="season_high" model="l10n_si.camping.season">
            <field name="name">Visoka sezona</field>
            <field name="code">high</field>
            <field name="date_from">2025-07-01</field>
            <field name="date_to">2025-08-31</field>
            <field name="multiplier">1.5</field>
        </record>
        <record id="season_autumn" model="l10n_si.camping.season">
            <field name="name">Jesen</field>
            <field name="code">shoulder</field>
            <field name="date_from">2025-09-01</field>
            <field name="date_to">2025-10-31</field>
            <field name="multiplier">0.8</field>
        </record>
        <record id="season_winter" model="l10n_si.camping.season">
            <field name="name">Zima (zaprto)</field>
            <field name="code">winter</field>
            <field name="date_from">2025-11-01</field>
            <field name="date_to">2025-12-31</field>
            <field name="multiplier">0.0</field>
        </record>
    </data>
</odoo>
