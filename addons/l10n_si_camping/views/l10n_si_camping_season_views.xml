<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_camping_season_tree" model="ir.ui.view">
        <field name="name">l10n_si.camping.season.tree</field>
        <field name="model">l10n_si.camping.season</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="multiplier"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_camping_season_form" model="ir.ui.view">
        <field name="name">l10n_si.camping.season.form</field>
        <field name="model">l10n_si.camping.season</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="multiplier"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_camping_season" model="ir.actions.act_window">
        <field name="name">Sezone</field>
        <field name="res_model">l10n_si.camping.season</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
