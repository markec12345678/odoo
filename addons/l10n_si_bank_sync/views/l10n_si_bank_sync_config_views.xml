<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_si_bank_sync_config_tree" model="ir.ui.view">
        <field name="name">l10n_si.bank.sync.config.tree</field>
        <field name="model">l10n_si.bank.sync.config</field>
        <field name="arch" type="xml">
            <list decoration-success="last_sync_date != False">
                <field name="bank_code"/>
                <field name="iban"/>
                <field name="journal_id"/>
                <field name="environment"/>
                <field name="auto_sync"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_si_bank_sync_config_form" model="ir.ui.view">
        <field name="name">l10n_si.bank.sync.config.form</field>
        <field name="model">l10n_si.bank.sync.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary"/>
                    <button name="action_sync_now" type="object" string="Sync Now" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="bank_code"/>
                            <field name="iban"/>
                            <field name="journal_id"/>
                            <field name="environment"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="auto_sync"/>
                            <field name="last_sync_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Avtentikacija" name="auth">
                            <group>
                                <group string="Basic Auth / API Key">
                                    <field name="api_username"/>
                                    <field name="api_password" password="True"/>
                                    <field name="api_key" password="True"/>
                                </group>
                                <group string="Certifikat (mTLS)">
                                    <field name="certificate" filename="certificate_filename"/>
                                    <field name="certificate_filename" invisible="1"/>
                                    <field name="certificate_password" password="True"/>
                                </group>
                            </group>
                            <group string="OAuth2 (Sparkasse George)">
                                <field name="oauth_client_id"/>
                                <field name="oauth_client_secret" password="True"/>
                                <field name="oauth_token" readonly="1"/>
                                <field name="oauth_token_expires_at" readonly="1"/>
                            </group>
                        </page>
                        <page string="Logi">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="state"/>
                                    <field name="statement_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_si_bank_sync_config" model="ir.actions.act_window">
        <field name="name">SI Bank Sync Configurations</field>
        <field name="res_model">l10n_si.bank.sync.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_si_bank_sync_root"
              name="SI Bank Sync"
              parent="account.menu_finance_configuration"
              sequence="95"/>

    <menuitem id="menu_si_bank_sync_config"
              name="Configurations"
              parent="menu_si_bank_sync_root"
              action="action_l10n_si_bank_sync_config"/>
</odoo>
