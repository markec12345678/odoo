<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_si_bank_sync" model="ir.ui.view">
        <field name="name">account.journal.form.si.bank.sync</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='si_bank_format']" position="after">
                <field name="si_bank_sync_config_id"
                       attrs="{'invisible': [('type', '!=', 'bank')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
