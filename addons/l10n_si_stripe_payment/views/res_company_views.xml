<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_stripe_si" model="ir.ui.view">
        <field name="name">res.company.form.stripe.si</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Stripe Payment Settings">
                    <field name="si_stripe_deposit_mode"/>
                    <field name="si_stripe_deposit_percentage" invisible="not si_stripe_deposit_mode"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
